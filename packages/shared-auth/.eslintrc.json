{
  "extends": [
    "../../.eslintrc.json"
  ],
  "ignorePatterns": [
    "!**/*",
    "**/vite.config.*.timestamp*",
    "**/vitest.config.*.timestamp*"
  ],
  "overrides": [
    {
      "files": [
        "*.ts",
        "*.tsx",
        "*.js",
        "*.jsx"
      ],
      "rules": {}
    },
    {
      "files": [
        "*.ts",
        "*.tsx"
      ],
      "rules": {}
    },
    {
      "files": [
        "*.js",
        "*.jsx"
      ],
      "rules": {}
    },
    {
      "files": [
        "src/react/**/*.ts",
        "src/react/**/*.tsx"
      ],
      "extends": [
        "plugin:@nx/react"
      ],
      "rules": {
        "react/jsx-no-useless-fragment": [
          "warn",
          {
            "allowExpressions": true
          }
        ]
      }
    }
  ]
}
