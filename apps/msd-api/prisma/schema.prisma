// msd-api Prisma schema — Postgres database "msd".
// Independent from mera-driver-api: no shared tables, no shared migrations.
//
// NOTE ON CLIENT OUTPUT: this is an Nx monorepo with a single root node_modules.
// mera-driver-api will define its own, separately-modeled schema.prisma in parallel.
// If both generators wrote to the default `node_modules/@prisma/client`, the second
// `prisma generate` to run would silently overwrite the first app's client with a
// different shape. Generating into this app's own `src/generated/prisma-client`
// keeps msd-api's client isolated regardless of what mera-driver-api does.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserStatus {
  active
  inactive
  blocked
}

/// Mirrors `PermissionAction` in packages/shared-types/src/index.ts — keep in sync.
enum PermissionAction {
  view
  create
  edit
  delete
  export
  import
  approve
  reject
  upload
  download
  print
  assign
  restore
  permanent_delete
  status_change
  custom
}

enum OtpPurpose {
  login
  signup
  change_phone
  change_email
}

enum LoginMethod {
  otp_email
  otp_phone
  google
}

// ─── Vendor / Branch / Deal ─────────────────────────────────────────────────

enum VendorStatus {
  PROFILE_INCOMPLETE
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DealStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

enum DealApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderType {
  SERVICE
  PRODUCT
}

/// PENDING_PAYMENT (renamed from PENDING in Phase 9 — same transitions, now explicit that a
/// freshly-created Order is always awaiting payment) -> CONFIRMED (payment verified) ->
/// COMPLETED, or -> CANCELLED from either PENDING_PAYMENT or CONFIRMED.
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Top-level Category rows only (`parentId: null`) carry a type — subcategories inherit their
/// parent's type by join, never duplicated on the child row (see Category's own doc comment).
/// Drives direct vendor Category access (VendorCategoryAccess) instead of the old shared
/// Service/Product master-row model.
enum CategoryType {
  SERVICE
  PRODUCT
  THERAPY
}

enum PaymentProvider {
  RAZORPAY
  /// Cash on Delivery — no gateway involved; see payment.service.ts's createCodPayment. A COD
  /// Payment row is created with status CREATED (never PAID — cash hasn't been collected yet),
  /// while the Order itself moves to CONFIRMED so the order is placed/fulfillable.
  COD
}

/// The minimal set Razorpay's real flow actually needs — no invented PENDING/REFUNDED (refunds
/// are out of scope this phase, see the Phase 9 architecture plan).
enum PaymentStatus {
  CREATED
  PAID
  FAILED
  CANCELLED
}

/// Display/classification hint on a Notification row — the actual recipient is always a real
/// `User` (see Notification's own doc comment), never a polymorphic reference keyed by this enum.
enum NotificationRecipientType {
  SUPERADMIN
  VENDOR
}

enum NotificationType {
  DEAL_PENDING_APPROVAL
  ORDER_RECEIVED
}

// ─── Core identity & RBAC ───────────────────────────────────────────────────

model User {
  id          String    @id @default(uuid())
  email       String?   @unique
  phone       String?   @unique
  name        String
  googleId    String?   @unique
  status      UserStatus @default(active)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete — never hard-delete user data

  roles                     UserRole[]
  refreshSessions           RefreshSession[]
  loginHistory              LoginHistory[]
  auditLogsAsActor          AuditLog[]              @relation("AuditLogActor")
  impersonationsAsAdmin     ImpersonationSession[]   @relation("ImpersonationSuperAdmin")
  impersonationsAsTarget    ImpersonationSession[]   @relation("ImpersonationTarget")
  vendorProfile             Vendor?                 @relation("VendorOwner")
  cart                      Cart?
  orders                    Order[]
  wishlistItems             WishlistItem[]
  notifications             Notification[]          @relation("NotificationRecipient")

  @@index([status])
}

model Role {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  description  String?
  isSystem     Boolean  @default(false)
  /// The ONLY place super-admin logic is allowed to live: seed.ts auto-grants every
  /// Permission to any role with this flag. Application code must never do a string
  /// comparison like `role.key === 'super_admin'` — always go through requirePermission().
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions       RolePermission[]
  users             UserRole[]
  dashboardWidgets  RoleDashboardWidget[]

  @@index([isActive])
}

model Permission {
  id        String            @id @default(uuid())
  menuKey   String
  action    PermissionAction
  /// Canonical `${menuKey}:${action}` — must match `permissionKeyFor()` in shared-permissions.
  key       String            @unique
  label     String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  roles RolePermission[]

  @@index([menuKey])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model DashboardWidget {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String
  module      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RoleDashboardWidget[]

  @@index([module])
}

model RoleDashboardWidget {
  roleId    String
  widgetId  String
  order     Int
  createdAt DateTime @default(now())

  role   Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  widget DashboardWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@id([roleId, widgetId])
  @@index([roleId])
  @@index([widgetId])
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model OtpChallenge {
  id         String     @id @default(uuid())
  identifier String
  purpose    OtpPurpose
  hashedOtp  String
  attempts   Int        @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([identifier, purpose])
  @@index([expiresAt])
}

model RefreshSession {
  id          String    @id @default(uuid())
  userId      String
  hashedToken String    @unique
  deviceInfo  String?
  ip          String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Audit / observability ──────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String
  action       String
  targetType   String
  targetId     String
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actor User @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetType, targetId])
}

/// A recipient is always a real User row — a Vendor notification resolves to `Vendor.ownerUserId`,
/// a Superadmin notification resolves to every User whose Role has `isSuperAdmin` — `recipientType`
/// is a display/classification hint only, never a polymorphic key. `entityType`/`entityId` mirror
/// AuditLog's `targetType`/`targetId` pattern for "what this notification is about" (e.g. "DEAL"/
/// dealId), with `metadata` for anything else the frontend's click-to-navigate needs (e.g. vendorId).
model Notification {
  id              String                    @id @default(uuid())
  recipientUserId String
  recipientType   NotificationRecipientType
  type            NotificationType
  title           String
  message         String
  entityType      String?
  entityId        String?
  metadata        Json?
  isRead          Boolean                   @default(false)
  readAt          DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  recipient User @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId])
  @@index([recipientUserId, isRead])
  @@index([entityType, entityId])
}

model LoginHistory {
  id        String      @id @default(uuid())
  userId    String
  method    LoginMethod
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ImpersonationSession {
  id               String    @id @default(uuid())
  superAdminUserId String
  targetUserId     String
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  previewTokenJti  String    @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  superAdmin User @relation("ImpersonationSuperAdmin", fields: [superAdminUserId], references: [id], onDelete: Cascade)
  target     User @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([superAdminUserId])
  @@index([targetUserId])
}

// ─── Vendor / Branch / Deal (business domain) ───────────────────────────────

model Vendor {
  id          String  @id @default(uuid())
  /// The User who logs in and manages this business. Null until an admin-created
  /// vendor is claimed, or set immediately on self-registration (== req.user.sub).
  ownerUserId String? @unique
  /// Public storefront URL slug (`/vendors/:slug`). Nullable — existing rows predate this
  /// column; backfilled once in seed.ts, never required at the DB level to avoid a
  /// backfill-before-migrate step. Unique so two vendors can never collide on one slug.
  slug        String? @unique

  // Business information
  /// Nullable: the admin-create pipeline persists a Vendor after Step 1 (Vendor User)
  /// with only ownerUserId set, before Business Details (Step 2) is filled in.
  businessName         String?
  legalName            String?
  businessType         String?
  businessDescription  String?
  businessEmail        String?
  businessPhone        String?
  alternatePhone       String?
  website              String?
  logoUrl              String?

  // Owner information
  /// Deprecated — kept for rows that predate the first/last name split, never written to by
  /// current UI (see `ownerFirstName`/`ownerLastName` below). Never dropped, per this schema's
  /// own "don't blindly delete a field old data may depend on" convention.
  ownerName             String?
  ownerFirstName        String?
  ownerLastName         String?
  contactPerson         String?
  ownerEmail            String?
  ownerMobile           String?
  alternateOwnerMobile  String?

  // Address
  address      String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  pincode      String?
  latitude     Decimal? @db.Decimal(10, 6)
  longitude    Decimal? @db.Decimal(10, 6)

  // Business / KYC information
  /// Deprecated — kept for rows that predate real KYC file upload (see `VendorDocument` below),
  /// never written to by current UI. Never dropped, same convention as `ownerName` above.
  gstNumber                   String?
  panNumber                   String?
  businessRegistrationNumber  String?
  /// Deprecated — free-form record of pasted document URLs: [{ type, url, uploadedAt }]. Real
  /// KYC documents are now actual uploaded files (see `VendorDocument`); this column is kept
  /// read-only for backward compatibility with any vendor onboarded before that existed.
  kycDocuments        Json?
  kycStatus           KycStatus @default(PENDING)
  kycRejectionReason  String?

  // Bank information
  bankAccountHolder  String?
  bankName           String?
  bankAccountNumber  String?
  bankIfsc           String?
  upiId              String?

  status          VendorStatus @default(PROFILE_INCOMPLETE)
  /// Reason recorded on reject/suspend — never on approve/activate.
  statusReason    String?
  /// Admin who created this vendor profile, if admin-created (self-registration leaves this null).
  createdByUserId String?

  /// Business module flags — kept explicit rather than derived from `categoryAccess` existing so
  /// "module checked, no category chosen yet" remains representable (a distinct validation state
  /// from "module not offered at all"). Set together with `categoryAccess` via
  /// `setVendorModulesAndCategoryAccess` (vendor.service.ts).
  offersService Boolean @default(false)
  offersProduct Boolean @default(false)
  offersTherapy Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User?       @relation("VendorOwner", fields: [ownerUserId], references: [id])
  branches   Branch[]
  deals      Deal[]
  orders     Order[]
  orderItems OrderItem[]
  therapists Therapist[]
  products    Product[]
  categoryAccess VendorCategoryAccess[]
  mediaImages VendorImage[]
  mediaVideo  VendorVideo?
  documents   VendorDocument[]

  @@index([status])
  @@index([ownerUserId])
}

/// A real uploaded KYC document (GST/PAN/Aadhaar) — one row per `documentType`, replacing the
/// deprecated `Vendor.gstNumber`/`panNumber`/`kycDocuments` pasted-text/URL fields. Deliberately
/// a real per-entity table (not a polymorphic entityType/entityId `Media` table), matching this
/// schema's established convention (see `DealImage`'s doc comment) — and one row per type (not
/// many-with-ordering like `VendorImage`) since exactly one active file per document type is the
/// whole model: re-uploading the same type replaces it via the `@@unique` below.
model VendorDocument {
  id               String             @id @default(uuid())
  vendorId         String
  documentType     VendorDocumentType
  storageKey       String
  originalFilename String?
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, documentType])
  @@index([vendorId])
}

enum VendorDocumentType {
  GST
  PAN
  AADHAAR
}

/// One uploaded image for a Vendor's public profile — part of the shared Deal/Product/
/// Therapist/Vendor media-upload system (see DealImage's doc comment for the full architecture
/// rationale, identical here). `Vendor.logoUrl` stays populated as the legacy pasted-URL field
/// and is never written to going forward; the frontend resolver prefers this table and falls
/// back to `logoUrl` only for rows that predate it.
model VendorImage {
  id               String   @id @default(uuid())
  vendorId         String
  storageKey       String
  originalFilename String?
  mimeType         String
  sizeBytes        Int
  sortOrder        Int      @default(0)
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

/// A Vendor's single optional profile video — one-to-one, enforced by the @unique on vendorId.
model VendorVideo {
  id               String   @id @default(uuid())
  vendorId         String   @unique
  storageKey       String
  originalFilename String?
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Branch {
  id        String  @id @default(uuid())
  vendorId  String
  name      String
  address   String?
  city      String?
  state     String?
  country   String?
  pincode   String?
  latitude  Decimal? @db.Decimal(10, 6)
  longitude Decimal? @db.Decimal(10, 6)
  phone     String?
  email     String?
  isActive  Boolean @default(true)
  /// Loosely-structured weekly hours, e.g. {"mon":"09:00-20:00",...,"sun":"closed"} — same
  /// no-upload-pipeline-style Json field as Vendor.kycDocuments/Deal.images. Nullable: existing
  /// seeded branches predate this column.
  openingHours Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  deals      Deal[]
  orders     Order[]
  orderItems OrderItem[]
  therapists Therapist[]

  @@index([vendorId])
}

/// A vendor+branch's staff member — an independent, directly browsable/bookable customer-facing
/// entity in its own right (see TherapistPackage's own doc comment), vendor+branch scoped like
/// Deal. Carries TWO distinct name concepts, never merged into one field: `therapistType` is the
/// service/role label a customer browses by (e.g. "Legs Therapist", "Head Massage Therapist" —
/// backfilled to the generic 'Therapist' for rows that predate this field, never a fabricated
/// specific guess; a vendor can edit it any time), and `personName` is the actual staff member
/// (e.g. "Ramesh Kumar" — this column used to be plainly `name` before Therapist became
/// independently browsable; renamed, not re-keyed, so every existing row's value carried over
/// unchanged). No delete endpoint — like Branch, only ever soft-disabled via isActive to avoid
/// orphaning historical CartItem/OrderItem rows that reference one.
model Therapist {
  id              String   @id @default(uuid())
  vendorId        String
  branchId        String
  therapistType   String   @default("Therapist")
  personName      String
  /// Nullable — no non-fabricated default exists for rows that predate this field.
  gender          String?
  /// Free-text, historical display only — kept untouched (never backfilled/repointed) for
  /// existing rows. Going forward, `specializationCategoryId` below is the restricted-choice
  /// field new Therapist create/update flows validate against (must be a top-level Category
  /// with `type: THERAPY` the vendor has been granted, or one of its subcategories).
  specialization  String?
  /// Restricted choice, added alongside the free-text `specialization` above — validated in
  /// vendor.service.ts's createTherapist/updateTherapist via assertVendorHasCategoryAccess.
  /// Nullable: not required, and every pre-existing Therapist row predates this column.
  specializationCategoryId String?
  bio             String?
  experienceYears Int?
  photoUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor     Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  specializationCategory Category? @relation("TherapistSpecialization", fields: [specializationCategoryId], references: [id])
  packages   TherapistPackage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  mediaImages TherapistImage[]
  mediaVideo  TherapistVideo?
  popularTagLinks PopularTagTherapist[]

  @@index([vendorId])
  @@index([branchId])
  @@index([specializationCategoryId])
}

/// A therapist's own duration/price menu — deliberately independent of any specific Deal (no
/// `dealId`): a vendor manages "Ramesh Kumar: 30 min ₹1,099, 60 min ₹1,499, 90 min ₹1,899" once,
/// the same way Deal's own sibling-Deal-rows duration/price list is managed independently (see
/// vendor.tsx's `groupServiceDeals` doc comment) — the two are separate, independently-CRUD'd
/// entities, never coupled through an admin "pick a Deal" step. A customer adds this
/// Therapist+package to their cart directly (browsing Therapists independent of any Deal — see
/// cart.service.ts#addItem's Therapist-line path); a Deal and a Therapist are independently
/// selected/priced cart lines, never coupled together on one CartItem/OrderItem. Real delete is
/// allowed (unlike Therapist, which is only ever soft-disabled) because CartItem/OrderItem never
/// reference this row by id at read time — only nullable `therapistPackageId` traceability
/// pointers, snapshotted immutably at cart/order time, so deleting a package can never alter a
/// past order's historical price.
model TherapistPackage {
  id              String   @id @default(uuid())
  therapistId     String
  durationMinutes Int
  sellingPrice    Decimal  @db.Decimal(10, 2)
  originalPrice   Decimal? @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  therapist  Therapist   @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([therapistId, durationMinutes])
  @@index([therapistId])
}

/// One uploaded photo for a Therapist — part of the shared Deal/Product/Therapist media-upload
/// system (see DealImage's doc comment for the full architecture rationale, identical here).
/// `Therapist.photoUrl` stays populated as the legacy single-URL field and is never written to
/// going forward; the resolver on the frontend prefers `images` (ordered by sortOrder, primary
/// first) and falls back to `photoUrl` only for rows that predate this table.
model TherapistImage {
  id               String   @id @default(uuid())
  therapistId      String
  storageKey       String
  originalFilename String?
  mimeType         String
  sizeBytes        Int
  sortOrder        Int      @default(0)
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId])
}

/// A Therapist's single optional video — one-to-one, enforced by the @unique on therapistId.
model TherapistVideo {
  id               String   @id @default(uuid())
  therapistId      String   @unique
  storageKey       String
  originalFilename String?
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
}

/// Self-referential category tree (a row with a non-null parentId IS a subcategory) — the
/// full CRUD backing for both `masters.categories` (parentId: null rows) and
/// `masters.sub-categories` (parentId: set rows) admin pages, and the source of
/// Deal.categoryId/subcategoryId.
model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  parentId    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  /// Nullable during migration only — backfilled by the direct_category_access data-fix, then
  /// tightened to required in a follow-up migration once every row has a value (see that
  /// migration's own comment). Only ever meaningful/set on a top-level row (`parentId: null`);
  /// a subcategory inherits its parent's type by join — never duplicated here.
  type        CategoryType?
  /// Drives the storefront's "Popular Category"/"Popular Therapy" carousels (Category rows with
  /// `type: THERAPY` double as flat specialization rows — see Therapist.specializationCategoryId).
  /// Combined with the existing `sortOrder` for display ordering; no separate table needed.
  isPopular   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  deals            Deal[]    @relation("DealCategory")
  subcategoryDeals Deal[]    @relation("DealSubcategory")
  products            Product[] @relation("ProductCategory")
  subcategoryProducts Product[] @relation("ProductSubcategory")
  vendorAccess        VendorCategoryAccess[]
  therapistSpecializations Therapist[] @relation("TherapistSpecialization")
  mediaImages CategoryImage[]
  popularTagLinks PopularTagCategory[]

  @@index([parentId])
}

/// One uploaded image for a Category row — part of the shared Deal/Product/Therapist/Vendor
/// media-upload system (see DealImage's doc comment for the full architecture rationale,
/// identical here). Since Category/Subcategory/Type are all just Category rows at different
/// depths (see Category's own schema doc comment), this one table covers image upload for all
/// three tiers with no extra per-tier wiring. No `CategoryVideo` model — no product/design need
/// for a category-level video has come up, unlike Deal/Product/Therapist/Vendor's own profile
/// videos; add one later the same way if that changes.
model CategoryImage {
  id               String   @id @default(uuid())
  categoryId       String
  storageKey       String
  originalFilename String?
  mimeType         String
  sizeBytes        Int
  sortOrder        Int      @default(0)
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

/// A vendor's direct grant of access to one TOP-LEVEL Category (checkbox-style, per business
/// module) — replaces the old model where any vendor could sell against any global Service/
/// Product master row with no restriction at all. Granting a top-level category implicitly
/// grants every one of its (current and future) active subcategories — never mapped manually,
/// never a separate row per subcategory (see vendor.service.ts#assertVendorHasCategoryAccess).
model VendorCategoryAccess {
  id         String   @id @default(uuid())
  vendorId   String
  categoryId String
  createdAt  DateTime @default(now())

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([vendorId, categoryId])
  @@index([vendorId])
  @@index([categoryId])
}

/// A Superadmin-managed marketing label ("Trending", "Best Seller", ...) mappable onto any mix
/// of Category/Deal/Product/Therapist rows. `isActive` is the ONLY thing a deactivate/reactivate
/// toggle touches — mapping rows are never deleted or recreated by a status change, so
/// reactivating a tag instantly restores every existing mapping with no remapping step. Four
/// separate join tables (not one polymorphic `entityType`/`entityId` table) to match this
/// schema's own established convention — see DealImage's doc comment, and VendorCategoryAccess
/// just above for the two-entity join-table shape this mirrors exactly.
model PopularTag {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories PopularTagCategory[]
  deals      PopularTagDeal[]
  products   PopularTagProduct[]
  therapists PopularTagTherapist[]
}

model PopularTagCategory {
  id         String   @id @default(uuid())
  tagId      String
  categoryId String
  createdAt  DateTime @default(now())

  tag      PopularTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  category Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([tagId, categoryId])
  @@index([tagId])
  @@index([categoryId])
}

model PopularTagDeal {
  id        String   @id @default(uuid())
  tagId     String
  dealId    String
  createdAt DateTime @default(now())

  tag  PopularTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  deal Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([tagId, dealId])
  @@index([tagId])
  @@index([dealId])
}

model PopularTagProduct {
  id        String   @id @default(uuid())
  tagId     String
  productId String
  createdAt DateTime @default(now())

  tag     PopularTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tagId, productId])
  @@index([tagId])
  @@index([productId])
}

model PopularTagTherapist {
  id          String   @id @default(uuid())
  tagId       String
  therapistId String
  createdAt   DateTime @default(now())

  tag       PopularTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  therapist Therapist  @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@unique([tagId, therapistId])
  @@index([tagId])
  @@index([therapistId])
}

/// A Deal is a vendor+branch's priced, bookable offering — either a service (no master catalog
/// row at all; the Deal's own title/description/durationMinutes/packages ARE the offering, see
/// `Category`'s `type: SERVICE` grant that authorizes it) or a Product purchase (`productId` set,
/// pointing at the vendor's own vendor-scoped Product row — `product.service.ts`). The old
/// `Service` master-catalog model is gone entirely — see the `direct_category_access` migration.
/// `productId` is nullable: unset means this is a service Deal, set means a product Deal; never
/// both concepts blended on one row (`vendor.service.ts` enforces the category-access gate for
/// either kind via `assertVendorHasCategoryAccess`).
model Deal {
  id            String  @id @default(uuid())
  vendorId      String
  branchId      String
  categoryId    String
  subcategoryId String?
  productId     String?

  title                    String
  slug                     String   @unique
  shortDescription         String?
  description              String?
  originalPrice            Decimal  @db.Decimal(10, 2)
  salePrice                Decimal  @db.Decimal(10, 2)
  discountPercent          Int?
  /// Only meaningful for a service deal (a bookable time slot) — never required for a
  /// Product deal.
  durationMinutes          Int?
  termsAndConditions       String?
  notes                    String?
  policy                   String?
  /// URLs only for this MVP — string[] of hosted image URLs, no upload pipeline.
  images                   Json?
  maxBookings              Int?
  availableBookings        Int?
  startDate                DateTime?
  endDate                  DateTime?
  status                   DealStatus         @default(DRAFT)
  approvalStatus           DealApprovalStatus @default(PENDING)
  approvalRejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category    Category  @relation("DealCategory", fields: [categoryId], references: [id])
  subcategory Category? @relation("DealSubcategory", fields: [subcategoryId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id])
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  packages      DealPackage[]
  mediaImages   DealImage[]
  mediaVideo    DealVideo?
  popularTagLinks PopularTagDeal[]

  @@index([vendorId])
  @@index([branchId])
  @@index([productId])
  @@index([status])
}

/// A service Deal's own duration/price menu — the authoritative child entity a customer actually
/// selects and books (mirrors TherapistPackage's shape/pattern exactly, see its own doc comment).
/// Never used for a product Deal (no serviceId, no duration concept). `Deal.durationMinutes`/
/// `salePrice`/`originalPrice` remain on Deal itself as a synced "from price"/default-duration
/// display cache (kept in sync with the cheapest active package by vendor.service.ts/
/// catalog.service.ts whenever packages change) so every existing minPrice/maxPrice/sort/badge
/// query and display continues to work unchanged — but cart/order pricing NEVER reads those
/// Deal fields for a service Deal that has packages; it always resolves the authoritative price
/// from the customer's selected DealPackage (see cart.service.ts#addItem).
model DealPackage {
  id              String   @id @default(uuid())
  dealId          String
  durationMinutes Int
  sellingPrice    Decimal  @db.Decimal(10, 2)
  originalPrice   Decimal? @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deal       Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([dealId, durationMinutes])
  @@index([dealId])
}

/// One uploaded image for a Deal — part of the shared Deal/Product/Therapist media-upload
/// system. Deliberately a real per-entity table (not a polymorphic entityType/entityId `Media`
/// table) so the FK + `onDelete: Cascade` gives real referential integrity, matching this
/// schema's established convention for every other child table (DealPackage, TherapistPackage).
/// `Deal.images` (Json) stays populated as the legacy URL-array field and is never written to
/// going forward — a one-time backfill script seeds one DealImage per legacy URL for existing
/// rows; the frontend resolver prefers this table and falls back to the legacy field only for
/// rows that were never re-edited after this table shipped. At most one row per dealId may have
/// `isPrimary = true` (enforced by a partial unique index in the migration, not just app logic).
model DealImage {
  id               String   @id @default(uuid())
  dealId           String
  storageKey       String
  originalFilename String?
  mimeType         String
  sizeBytes        Int
  sortOrder        Int      @default(0)
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

/// A Deal's single optional video — one-to-one, enforced by the @unique on dealId.
model DealVideo {
  id               String   @id @default(uuid())
  dealId           String   @unique
  storageKey       String
  originalFilename String?
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

/// Vendor-owned retail product catalog (e.g. skincare) — each Product belongs to exactly one
/// Vendor (`vendorId`, required), unlike the pre-`direct_category_access` model where Product was
/// a shared global master row any vendor could sell against. Still sold via a `Deal` row with
/// `productId` set (Cart/Order/Payment code is unchanged — see the migration's own doc comment).
/// `brand` is a plain label, not a relation. subcategoryId mirrors Deal's optional pattern.
model Product {
  id            String  @id @default(uuid())
  vendorId      String
  name          String
  slug          String  @unique
  brand         String?
  categoryId    String
  subcategoryId String?

  description  String?
  summary      String?
  /// string[]
  benefits     Json?
  /// string[]
  howToUse     Json?
  ingredients  String?
  returnPolicy String?

  /// URL only for this MVP — no upload pipeline, matches Vendor/Deal's existing approach.
  image    String?
  /// string[] of hosted image URLs.
  gallery  Json?
  imageAlt String?
  badge    String?

  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  /// Percentage off, matches the existing storefront field name exactly.
  discount      Int?

  isNew      Boolean @default(false)
  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category    Category  @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategory Category? @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  deals       Deal[]
  mediaImages ProductImage[]
  mediaVideo  ProductVideo?
  popularTagLinks PopularTagProduct[]

  @@index([categoryId])
  @@index([vendorId])
}

/// One uploaded image for a Product — part of the shared Deal/Product/Therapist media-upload
/// system (see DealImage's doc comment for the full architecture rationale, identical here).
/// `Product.image`/`gallery` stay populated as the legacy fields and are never written to going
/// forward; the frontend resolver prefers this table and falls back to the legacy fields only
/// for rows that predate it.
model ProductImage {
  id               String   @id @default(uuid())
  productId        String
  storageKey       String
  originalFilename String?
  mimeType         String
  sizeBytes        Int
  sortOrder        Int      @default(0)
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// A Product's single optional video — one-to-one, enforced by the @unique on productId.
model ProductVideo {
  id               String   @id @default(uuid())
  productId        String   @unique
  storageKey       String
  originalFilename String?
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Cart (unified purchase intent — Deal, Product, and Therapist alike) ────

/// One customer, one active cart, holding every purchase-intent kind (Product deal, Service-Deal,
/// and Therapist — see CartItem's own doc comment for the discriminated shape). customerId is
/// always req.user.sub, never client-supplied, exactly like Vendor.ownerUserId's resolution.
/// Multi-vendor: a cart may hold lines from any number of different vendors/branches — each
/// CartItem's own deal/therapist relation is authoritative, so Cart itself carries no vendor/
/// branch field at all. Checkout groups items by vendor when creating Order/OrderItem rows — see
/// order.service.ts#createOrderFromCart.
model Cart {
  id         String  @id @default(uuid())
  customerId String  @unique

  /// Set when `createOrderFromCart` creates an Order from this cart's items — the cart's items
  /// are deliberately NOT deleted at that moment (only once payment actually succeeds, via
  /// `finalizeCartForOrder`, see order.service.ts/payment.service.ts). While set, a repeat
  /// checkout call reuses this same Order instead of creating a duplicate (same idempotency
  /// discipline as Payment's own createOrReusePayment). Cleared back to null either by
  /// `finalizeCartForOrder` (success) or by `createOrderFromCart` itself, when it finds this
  /// pointing at an Order that's since gone CANCELLED (so a fresh checkout attempt can proceed).
  pendingOrderId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items       CartItem[]
  pendingOrder Order?    @relation(fields: [pendingOrderId], references: [id])
}

/// One unified purchase-intent line, discriminated by which fields are set (see cart.service.ts's
/// `addItem` for the enforcement of each shape — never a DB-level CHECK constraint, same
/// discipline as Deal's/Booking's own "exactly one of X/Y" invariants elsewhere in this schema):
///   - Product line:      `dealId` set (a Product deal, `deal.productId != null`); `dealPackageId`/
///     `therapistId`/`therapistPackageId` all null.
///   - Service-Deal line: `dealId` + `dealPackageId` both set (package selection is mandatory
///     whenever the deal has any active `DealPackage` — see cart.service.ts); `therapistId`/
///     `therapistPackageId` null.
///   - Therapist line:    `therapistId` + `therapistPackageId` both set (package selection is
///     mandatory — mirrors the Service-Deal line); `dealId`/`dealPackageId` null.
/// No Booking row is ever created from this data — checkout (order.service.ts) turns each line
/// directly into one `OrderItem`, which alone fully represents a Deal/Therapist/Product purchase.
model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  /// Product line or Service-Deal line — see this model's own doc comment. Nullable: a Therapist
  /// line has no Deal involved at all.
  dealId    String?
  /// Set alongside `dealId` for a Service-Deal line (mandatory whenever the deal has active
  /// packages) — never set for a Product line or a Therapist line.
  dealPackageId String?
  /// Therapist line — see this model's own doc comment. Nullable: a Product/Service-Deal line has
  /// no Therapist involved at all.
  therapistId String?
  /// Set alongside `therapistId` for a Therapist line (mandatory) — never set otherwise.
  therapistPackageId String?
  quantity  Int     @default(1)
  /// Captured when added — provisional, not an immutable snapshot. Cart hasn't committed to
  /// anything yet; checkout (order.service.ts#createOrderFromCart) re-checks against the live
  /// Deal/DealPackage/Therapist/TherapistPackage price before charging.
  unitPrice Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart             Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  deal             Deal?             @relation(fields: [dealId], references: [id])
  dealPackage      DealPackage?      @relation(fields: [dealPackageId], references: [id], onDelete: SetNull)
  therapist        Therapist?        @relation(fields: [therapistId], references: [id])
  therapistPackage TherapistPackage? @relation(fields: [therapistPackageId], references: [id], onDelete: SetNull)

  /// Relaxed from the old product-cart-only `@@unique([cartId, dealId])` to accommodate multiple
  /// packages of the same deal and multiple therapist lines in one cart. Postgres unique indexes
  /// treat NULLs as pairwise-distinct (never equal to each other), so e.g. two different
  /// Service-Deal lines for the same `dealId` but different `dealPackageId` are correctly treated
  /// as distinct rows here — verified against Postgres's documented unique-index null semantics.
  /// `cart.service.ts#addItem` additionally re-checks for an existing matching line before insert
  /// as an application-level backstop (defense in depth, not reliance on this alone).
  @@unique([cartId, dealId, dealPackageId, therapistId, therapistPackageId])
  @@index([dealId])
  @@index([dealPackageId])
  @@index([therapistId])
  @@index([therapistPackageId])
}

/// A customer's "saved for later" list — any deal type (service or product). customerId is
/// always req.user.sub, never client-supplied, same resolution as Cart. Visibility of an item's
/// Deal is re-checked at read time against
/// catalog.service.ts's VISIBLE_DEAL_WHERE (not enforced here in the DB — a Deal can legitimately
/// go inactive/rejected after being wishlisted, and the item should just stop appearing rather
/// than being deleted, so the customer's intent isn't silently lost if the deal comes back).
model WishlistItem {
  id         String   @id @default(uuid())
  customerId String
  dealId     String
  createdAt  DateTime @default(now())

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal     Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([customerId, dealId])
  @@index([customerId])
  @@index([dealId])
}

// ─── Order (Cart convergence point — Deal/Product/Therapist unified) ─────────

/// The single convergence point for every purchase flow (Deal, Product, and Therapist all go
/// through Cart -> Order/OrderItem now — there is no separate Booking model; `OrderItem` alone,
/// via its `dealId`/`therapistId`/`therapistPackageId`/`dealPackageId`/`itemType` fields, fully
/// represents a Deal, Product, or Therapist purchase line). Never re-reads Deal/Vendor/Branch
/// after creation; every display field is snapshotted once (see OrderItem + vendorNameSnapshot/
/// branchNameSnapshot below), so a later Deal price edit, Vendor rename, or Branch address change
/// can never alter an existing Order.
///
/// Multi-vendor: a PRODUCT order created from a cart may span several vendors/branches in one
/// checkout/one payment (see order.service.ts#createOrderFromCart) — the real, authoritative
/// per-line vendor/branch lives on OrderItem below, not here. `vendorId`/`branchId`/
/// `vendorNameSnapshot`/`branchNameSnapshot` on Order are the "primary vendor" (the first item's
/// vendor at creation time) kept for backward compatibility with every existing single-vendor
/// display (order-detail header, invoice header, admin list) — for a single-vendor order (still
/// the common case: every SERVICE order, and any PRODUCT order whose cart happened to hold one
/// vendor) these are byte-identical to every item's own vendor, so nothing about the existing
/// single-vendor experience changes. Vendor-scoped authorization (who may list/see this order)
/// MUST check OrderItem.vendorId, never this field alone — see order.service.ts#listOrders.
model Order {
  id         String      @id @default(uuid())
  customerId String
  vendorId   String
  branchId   String
  type       OrderType
  status     OrderStatus @default(PENDING_PAYMENT)

  /// Snapshotted once at creation — "primary vendor" for a multi-vendor order, see the model
  /// doc comment above. Display must prefer these (or, for per-line vendor, OrderItem's own)
  /// over the live Vendor/Branch relation.
  vendorNameSnapshot String
  branchNameSnapshot String

  /// Checkout's "Customer Details" step — collected/confirmed once per order, before payment.
  /// Nullable: every pre-existing Order predates this step, and it stays optional at the schema
  /// level so it's never a breaking change for a caller that omits it; the frontend enforces
  /// "required before payment" as UX, not a DB constraint.
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingPincode String?

  subtotal Decimal @db.Decimal(10, 2)
  /// == subtotal for now (no coupons/tax/delivery yet) — stored separately because they'll
  /// diverge once those later phases exist.
  total    Decimal @db.Decimal(10, 2)

  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor   Vendor      @relation(fields: [vendorId], references: [id])
  branch   Branch      @relation(fields: [branchId], references: [id])
  items    OrderItem[]
  payments Payment[]
  /// Back-relation for Cart.pendingOrderId — see that field's doc comment. Nullable/optional:
  /// most Orders (once finalized, or every Order predating this field) have no Cart pointing at
  /// them anymore.
  pendingForCart Cart?

  @@index([customerId])
  @@index([vendorId])
  @@index([branchId])
  @@index([status])
}

/// Every Order has at least one OrderItem — one per CartItem line checked out (Deal, Product, or
/// Therapist alike). Keeping this uniform means nothing downstream ever special-cases a
/// service/therapist line — there is no separate Booking row to read instead.
///
/// Each item carries its OWN vendor/branch (never re-read from Deal — see Order's doc comment):
/// a multi-vendor PRODUCT order groups items from several vendors under one Order/one Payment,
/// and vendor-scoped authorization (a vendor's own order listing/detail) filters and matches on
/// THESE fields, not Order.vendorId. For a SERVICE order or a single-vendor PRODUCT order this is
/// simply identical to the parent Order's own vendorId/branchId — no behavior change there.
/// A line item is a Deal purchase, a directly-booked Therapist purchase, or a Product purchase —
/// exactly one of `dealId`/`therapistId` is ever set for a SERVICE item (never neither), and
/// neither for a PRODUCT item. `therapistPackageId` accompanies `therapistId` for a direct
/// Therapist purchase, or stands alongside `dealId` when a Deal line used a therapist package.
model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  vendorId  String
  branchId  String
  /// Kept for admin traceability only — display must use the snapshot fields below, never
  /// re-read Deal. Nullable — absent for a Therapist purchased directly, with no Deal involved.
  dealId  String?
  /// Traceability only — never re-read for price/duration, the snapshot fields below remain
  /// authoritative.
  therapistId        String?
  therapistPackageId String?
  /// Which DealPackage priced this line item, same traceability-only discipline. Never set for a
  /// product line item or a Therapist-direct line item.
  dealPackageId String?

  itemName           String    // service.name / therapistType+personName / product.name at order time
  itemType            OrderType
  vendorNameSnapshot String
  branchNameSnapshot String
  unitPrice       Decimal   @db.Decimal(10, 2)
  quantity        Int
  lineTotal       Decimal   @db.Decimal(10, 2)
  /// Service only — never set for a product line item.
  durationMinutes Int?

  deal             Deal?             @relation(fields: [dealId], references: [id])
  dealPackage      DealPackage?      @relation(fields: [dealPackageId], references: [id], onDelete: SetNull)
  therapist        Therapist?        @relation(fields: [therapistId], references: [id])
  therapistPackage TherapistPackage? @relation(fields: [therapistPackageId], references: [id], onDelete: SetNull)
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  branch           Branch            @relation(fields: [branchId], references: [id])

  @@index([orderId])
  @@index([dealId])
  @@index([vendorId])
  @@index([therapistId])
  @@index([therapistPackageId])
  @@index([dealPackageId])
}

// ─── Payment (Phase 9 — Razorpay) ─────────────────────────────────────────────

/// Order 1 -> Payment[], deliberately NOT one-to-one: a retry (after a FAILED/CANCELLED
/// attempt) creates a new Payment row against the SAME Order rather than a new Order, so
/// "customer clicks Pay twice" or "payment fails then customer retries" never multiplies
/// Orders — only ever Payment attempts. See payment.service.ts for the reuse-vs-create rule.
model Payment {
  id       String          @id @default(uuid())
  orderId  String
  provider PaymentProvider @default(RAZORPAY)

  /// Razorpay order_xxx — one per attempt/row. NOT globally unique — a combined checkout (Deal
  /// + Therapist + Product together: one checkout action, one payment, multiple Order rows
  /// under the hood, see payment.service.ts's `*Batch` functions) creates ONE Razorpay order
  /// funding several msd Orders at once, so several Payment rows legitimately share the same
  /// providerOrderId (one per Order in the batch). Indexed, not unique — lookups use `findMany`.
  providerOrderId String
  /// Razorpay pay_xxx — set only once a payment actually succeeds. Same batch-sharing reasoning
  /// as providerOrderId above.
  providerPaymentId String?

  /// == Order.total at the moment this Payment was created — server-computed from the
  /// authoritative Order, never a client-supplied amount.
  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  status        PaymentStatus @default(CREATED)
  failureReason String?
  /// True only once the server has independently recomputed and matched Razorpay's HMAC
  /// signature (widget-callback or webhook path) — never set from a bare frontend claim.
  signatureVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([providerOrderId])
  @@index([providerPaymentId])
}
