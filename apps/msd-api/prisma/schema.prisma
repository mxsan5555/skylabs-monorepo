// msd-api Prisma schema — Postgres database "msd".
// Independent from mera-driver-api: no shared tables, no shared migrations.
//
// NOTE ON CLIENT OUTPUT: this is an Nx monorepo with a single root node_modules.
// mera-driver-api will define its own, separately-modeled schema.prisma in parallel.
// If both generators wrote to the default `node_modules/@prisma/client`, the second
// `prisma generate` to run would silently overwrite the first app's client with a
// different shape. Generating into this app's own `src/generated/prisma-client`
// keeps msd-api's client isolated regardless of what mera-driver-api does.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserStatus {
  active
  inactive
  blocked
}

/// Mirrors `PermissionAction` in packages/shared-types/src/index.ts — keep in sync.
enum PermissionAction {
  view
  create
  edit
  delete
  export
  import
  approve
  reject
  upload
  download
  print
  assign
  restore
  permanent_delete
  status_change
  custom
}

enum OtpPurpose {
  login
  signup
  change_phone
  change_email
}

enum LoginMethod {
  otp_email
  otp_phone
  google
}

// ─── Vendor / Branch / Deal ─────────────────────────────────────────────────

enum VendorStatus {
  PROFILE_INCOMPLETE
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DealStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

enum DealApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum OrderType {
  SERVICE
  PRODUCT
}

/// PENDING_PAYMENT (renamed from PENDING in Phase 9 — same transitions, now explicit that a
/// freshly-created Order is always awaiting payment) -> CONFIRMED (payment verified) ->
/// COMPLETED, or -> CANCELLED from either PENDING_PAYMENT or CONFIRMED.
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentProvider {
  RAZORPAY
  /// Cash on Delivery — no gateway involved; see payment.service.ts's createCodPayment. A COD
  /// Payment row is created with status CREATED (never PAID — cash hasn't been collected yet),
  /// while the Order itself moves to CONFIRMED so the order is placed/fulfillable.
  COD
}

/// The minimal set Razorpay's real flow actually needs — no invented PENDING/REFUNDED (refunds
/// are out of scope this phase, see the Phase 9 architecture plan).
enum PaymentStatus {
  CREATED
  PAID
  FAILED
  CANCELLED
}

// ─── Core identity & RBAC ───────────────────────────────────────────────────

model User {
  id          String    @id @default(uuid())
  email       String?   @unique
  phone       String?   @unique
  name        String
  googleId    String?   @unique
  status      UserStatus @default(active)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete — never hard-delete user data

  roles                     UserRole[]
  refreshSessions           RefreshSession[]
  loginHistory              LoginHistory[]
  auditLogsAsActor          AuditLog[]              @relation("AuditLogActor")
  impersonationsAsAdmin     ImpersonationSession[]   @relation("ImpersonationSuperAdmin")
  impersonationsAsTarget    ImpersonationSession[]   @relation("ImpersonationTarget")
  vendorProfile             Vendor?                 @relation("VendorOwner")
  cart                      Cart?
  bookings                  Booking[]
  orders                    Order[]
  wishlistItems             WishlistItem[]

  @@index([status])
}

model Role {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  description  String?
  isSystem     Boolean  @default(false)
  /// The ONLY place super-admin logic is allowed to live: seed.ts auto-grants every
  /// Permission to any role with this flag. Application code must never do a string
  /// comparison like `role.key === 'super_admin'` — always go through requirePermission().
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions       RolePermission[]
  users             UserRole[]
  dashboardWidgets  RoleDashboardWidget[]

  @@index([isActive])
}

model Permission {
  id        String            @id @default(uuid())
  menuKey   String
  action    PermissionAction
  /// Canonical `${menuKey}:${action}` — must match `permissionKeyFor()` in shared-permissions.
  key       String            @unique
  label     String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  roles RolePermission[]

  @@index([menuKey])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model DashboardWidget {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String
  module      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RoleDashboardWidget[]

  @@index([module])
}

model RoleDashboardWidget {
  roleId    String
  widgetId  String
  order     Int
  createdAt DateTime @default(now())

  role   Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  widget DashboardWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@id([roleId, widgetId])
  @@index([roleId])
  @@index([widgetId])
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model OtpChallenge {
  id         String     @id @default(uuid())
  identifier String
  purpose    OtpPurpose
  hashedOtp  String
  attempts   Int        @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([identifier, purpose])
  @@index([expiresAt])
}

model RefreshSession {
  id          String    @id @default(uuid())
  userId      String
  hashedToken String    @unique
  deviceInfo  String?
  ip          String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Audit / observability ──────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String
  action       String
  targetType   String
  targetId     String
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actor User @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetType, targetId])
}

model LoginHistory {
  id        String      @id @default(uuid())
  userId    String
  method    LoginMethod
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ImpersonationSession {
  id               String    @id @default(uuid())
  superAdminUserId String
  targetUserId     String
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  previewTokenJti  String    @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  superAdmin User @relation("ImpersonationSuperAdmin", fields: [superAdminUserId], references: [id], onDelete: Cascade)
  target     User @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([superAdminUserId])
  @@index([targetUserId])
}

// ─── Vendor / Branch / Deal (business domain) ───────────────────────────────

model Vendor {
  id          String  @id @default(uuid())
  /// The User who logs in and manages this business. Null until an admin-created
  /// vendor is claimed, or set immediately on self-registration (== req.user.sub).
  ownerUserId String? @unique
  /// Public storefront URL slug (`/vendors/:slug`). Nullable — existing rows predate this
  /// column; backfilled once in seed.ts, never required at the DB level to avoid a
  /// backfill-before-migrate step. Unique so two vendors can never collide on one slug.
  slug        String? @unique

  // Business information
  /// Nullable: the admin-create pipeline persists a Vendor after Step 1 (Vendor User)
  /// with only ownerUserId set, before Business Details (Step 2) is filled in.
  businessName         String?
  legalName            String?
  businessType         String?
  businessDescription  String?
  businessEmail        String?
  businessPhone        String?
  alternatePhone       String?
  website              String?
  logoUrl              String?

  // Owner information
  ownerName             String?
  contactPerson         String?
  ownerEmail            String?
  ownerMobile           String?
  alternateOwnerMobile  String?

  // Address
  address   String?
  city      String?
  state     String?
  country   String?
  pincode   String?
  latitude  Decimal? @db.Decimal(10, 6)
  longitude Decimal? @db.Decimal(10, 6)

  // Business / KYC information
  gstNumber                   String?
  panNumber                   String?
  businessRegistrationNumber  String?
  /// Free-form record of uploaded document URLs: [{ type, url, uploadedAt }]. URL/string
  /// only for this MVP — no upload pipeline exists yet (see CLAUDE.md/plan notes).
  kycDocuments        Json?
  kycStatus           KycStatus @default(PENDING)
  kycRejectionReason  String?

  // Bank information
  bankAccountHolder  String?
  bankName           String?
  bankAccountNumber  String?
  bankIfsc           String?
  upiId              String?

  status          VendorStatus @default(PROFILE_INCOMPLETE)
  /// Reason recorded on reject/suspend — never on approve/activate.
  statusReason    String?
  /// Admin who created this vendor profile, if admin-created (self-registration leaves this null).
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User?       @relation("VendorOwner", fields: [ownerUserId], references: [id])
  branches   Branch[]
  deals      Deal[]
  bookings   Booking[]
  orders     Order[]
  orderItems OrderItem[]
  therapists Therapist[]

  @@index([status])
  @@index([ownerUserId])
}

model Branch {
  id        String  @id @default(uuid())
  vendorId  String
  name      String
  address   String?
  city      String?
  state     String?
  country   String?
  pincode   String?
  latitude  Decimal? @db.Decimal(10, 6)
  longitude Decimal? @db.Decimal(10, 6)
  phone     String?
  email     String?
  isActive  Boolean @default(true)
  /// Loosely-structured weekly hours, e.g. {"mon":"09:00-20:00",...,"sun":"closed"} — same
  /// no-upload-pipeline-style Json field as Vendor.kycDocuments/Deal.images. Nullable: existing
  /// seeded branches predate this column.
  openingHours Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  deals      Deal[]
  bookings   Booking[]
  orders     Order[]
  orderItems OrderItem[]
  therapists Therapist[]

  @@index([vendorId])
}

/// A vendor+branch's staff member — an independent, directly browsable/bookable customer-facing
/// entity in its own right (see TherapistPackage's own doc comment), vendor+branch scoped like
/// Deal. Carries TWO distinct name concepts, never merged into one field: `therapistType` is the
/// service/role label a customer browses by (e.g. "Legs Therapist", "Head Massage Therapist" —
/// backfilled to the generic 'Therapist' for rows that predate this field, never a fabricated
/// specific guess; a vendor can edit it any time), and `personName` is the actual staff member
/// (e.g. "Ramesh Kumar" — this column used to be plainly `name` before Therapist became
/// independently browsable; renamed, not re-keyed, so every existing row's value carried over
/// unchanged). No delete endpoint — like Branch, only ever soft-disabled via isActive to avoid
/// orphaning historical Bookings that reference one.
model Therapist {
  id              String   @id @default(uuid())
  vendorId        String
  branchId        String
  therapistType   String   @default("Therapist")
  personName      String
  /// Nullable — no non-fabricated default exists for rows that predate this field.
  gender          String?
  specialization  String?
  bio             String?
  experienceYears Int?
  photoUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor     Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bookings   Booking[]
  packages   TherapistPackage[]
  orderItems OrderItem[]

  @@index([vendorId])
  @@index([branchId])
}

/// A therapist's own duration/price menu — deliberately independent of any specific Deal (no
/// `dealId`): a vendor manages "Ramesh Kumar: 30 min ₹1,099, 60 min ₹1,499, 90 min ₹1,899" once,
/// the same way Deal's own sibling-Deal-rows duration/price list is managed independently (see
/// vendor.tsx's `groupServiceDeals` doc comment) — the two are separate, independently-CRUD'd
/// entities, never coupled through an admin "pick a Deal" step. A customer can book this
/// Therapist+package DIRECTLY (browsing Therapists independent of any Deal — see
/// booking.service.ts#createBooking's Deal-less path), or combine it with a Deal booking:
/// booking.service.ts matches the customer's selected Deal's own `durationMinutes` against this
/// therapist's own rows by that same `durationMinutes` (never by any shared id) — if the
/// selected therapist has no active package at that exact duration, that's an invalid
/// combination and the booking is rejected (see resolveBookingPrice's doc comment). When a
/// match exists, its `sellingPrice` overrides the base Deal price; therapist selection on a Deal
/// booking is always optional — omitting one simply charges the Deal's own price. Real delete is
/// allowed (unlike Therapist, which is only ever soft-disabled) because Booking/OrderItem never
/// reference this row by id at read time — only nullable `therapistPackageId` traceability
/// pointers, snapshotted immutably into priceSnapshot/durationMinutesSnapshot at booking time,
/// so deleting a package can never alter a past booking's historical price.
model TherapistPackage {
  id              String   @id @default(uuid())
  therapistId     String
  durationMinutes Int
  sellingPrice    Decimal  @db.Decimal(10, 2)
  originalPrice   Decimal? @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  therapist  Therapist   @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  bookings   Booking[]
  orderItems OrderItem[]

  @@unique([therapistId, durationMinutes])
  @@index([therapistId])
}

/// Self-referential category tree (a row with a non-null parentId IS a subcategory) — the
/// full CRUD backing for both `masters.categories` (parentId: null rows) and
/// `masters.sub-categories` (parentId: set rows) admin pages, and the source of
/// Deal.categoryId/subcategoryId.
model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  parentId    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  deals            Deal[]    @relation("DealCategory")
  subcategoryDeals Deal[]    @relation("DealSubcategory")
  products            Product[] @relation("ProductCategory")
  subcategoryProducts Product[] @relation("ProductSubcategory")
  services            Service[] @relation("ServiceCategory")
  subcategoryServices Service[] @relation("ServiceSubcategory")

  @@index([parentId])
}

/// A Deal is a vendor+branch's priced, bookable offering of exactly one catalog item — a
/// Service (see the Haircut example in the marketplace architecture plan) or a Product, never
/// both, never neither, for any Deal created going forward (`service.service.ts`/
/// `product.service.ts` stay the unpriced, vendor-independent catalog masters — see their own
/// doc comments). `serviceId`/`productId` are nullable at the column level only so pre-existing
/// Deal rows (created before this migration, when neither column existed) remain valid without
/// a backfill; `vendor.service.ts` enforces "exactly one" at the application layer for every
/// create and for any update that touches either field.
model Deal {
  id            String  @id @default(uuid())
  vendorId      String
  branchId      String
  categoryId    String
  subcategoryId String?
  serviceId     String?
  productId     String?

  title                    String
  slug                     String   @unique
  shortDescription         String?
  description              String?
  originalPrice            Decimal  @db.Decimal(10, 2)
  salePrice                Decimal  @db.Decimal(10, 2)
  discountPercent          Int?
  /// Only meaningful when serviceId is set (a bookable time slot) — never required for a
  /// Product deal.
  durationMinutes          Int?
  termsAndConditions       String?
  /// URLs only for this MVP — string[] of hosted image URLs, no upload pipeline.
  images                   Json?
  maxBookings              Int?
  availableBookings        Int?
  startDate                DateTime?
  endDate                  DateTime?
  status                   DealStatus         @default(DRAFT)
  approvalStatus           DealApprovalStatus @default(PENDING)
  approvalRejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category    Category  @relation("DealCategory", fields: [categoryId], references: [id])
  subcategory Category? @relation("DealSubcategory", fields: [subcategoryId], references: [id])
  service     Service?  @relation(fields: [serviceId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id])
  cartItems     CartItem[]
  bookings      Booking[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  packages      DealPackage[]

  @@index([vendorId])
  @@index([branchId])
  @@index([serviceId])
  @@index([productId])
  @@index([status])
}

/// A service Deal's own duration/price menu — the authoritative child entity a customer actually
/// selects and books (mirrors TherapistPackage's shape/pattern exactly, see its own doc comment).
/// Never used for a product Deal (no serviceId, no duration concept). `Deal.durationMinutes`/
/// `salePrice`/`originalPrice` remain on Deal itself as a synced "from price"/default-duration
/// display cache (kept in sync with the cheapest active package by vendor.service.ts/
/// catalog.service.ts whenever packages change) so every existing minPrice/maxPrice/sort/badge
/// query and display continues to work unchanged — but booking/cart pricing NEVER reads those
/// Deal fields for a service Deal that has packages; it always resolves the authoritative price
/// from the customer's selected DealPackage (see booking.service.ts#createBookingFromDeal).
model DealPackage {
  id              String   @id @default(uuid())
  dealId          String
  durationMinutes Int
  sellingPrice    Decimal  @db.Decimal(10, 2)
  originalPrice   Decimal? @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deal       Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  bookings   Booking[]
  orderItems OrderItem[]

  @@unique([dealId, durationMinutes])
  @@index([dealId])
}

/// Standalone retail product catalog (e.g. skincare) — unlike Deal, NOT vendor/branch-scoped;
/// nothing in the existing storefront data (apps/msd/src/data/products.ts) ties a product to a
/// vendor. `brand` is a plain label, not a relation. subcategoryId mirrors Deal's optional
/// pattern even though the source data doesn't use it yet.
model Product {
  id            String  @id @default(uuid())
  name          String
  slug          String  @unique
  brand         String?
  categoryId    String
  subcategoryId String?

  description  String?
  summary      String?
  /// string[]
  benefits     Json?
  /// string[]
  howToUse     Json?
  ingredients  String?
  returnPolicy String?

  /// URL only for this MVP — no upload pipeline, matches Vendor/Deal's existing approach.
  image    String?
  /// string[] of hosted image URLs.
  gallery  Json?
  imageAlt String?
  badge    String?

  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  /// Percentage off, matches the existing storefront field name exactly.
  discount      Int?

  isNew      Boolean @default(false)
  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    Category  @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategory Category? @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  deals       Deal[]

  @@index([categoryId])
}

/// Marketplace service catalog master (e.g. "Haircut") — Category/Sub-category scoped, like
/// Product. Deliberately NEVER priced and NEVER vendor/branch-scoped: a vendor's actual
/// bookable offering of a Service (price, duration, vendor, branch) is represented by a Deal
/// row (Phase 4/5 of the marketplace architecture plan), not by fields on this model.
model Service {
  id            String  @id @default(uuid())
  name          String
  slug          String  @unique
  categoryId    String
  subcategoryId String?

  description String?
  image       String?
  imageAlt    String?
  /// Typical duration for this service type; a vendor's Deal may override it per offering.
  defaultDurationMinutes Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    Category  @relation("ServiceCategory", fields: [categoryId], references: [id])
  subcategory Category? @relation("ServiceSubcategory", fields: [subcategoryId], references: [id])
  deals       Deal[]

  @@index([categoryId])
}

// ─── Cart / Booking (Phase 7 — customer catalogue → purchase intent) ────────

/// One customer, one active cart, PRODUCT deals only (never a service deal — Booking is the
/// service equivalent, see the Booking model doc comment). customerId is always req.user.sub,
/// never client-supplied, exactly like Vendor.ownerUserId's resolution.
/// Multi-vendor: a cart may hold product deals from any number of different vendors/branches —
/// each CartItem's own `deal.vendorId`/`deal.branchId` is authoritative, so Cart itself carries
/// no vendor/branch field at all (the old single-vendor-per-cart lock lived here and in
/// cart.service.ts; both removed together). Checkout groups items by vendor when creating Order/
/// OrderItem rows — see order.service.ts#createOrderFromCart.
model Cart {
  id         String  @id @default(uuid())
  customerId String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  /// Must reference a Product deal (deal.productId != null) — enforced in cart.service.ts.
  dealId    String
  quantity  Int     @default(1)
  /// Captured when added — provisional, not the historical/immutable snapshot Booking has below.
  /// Cart hasn't committed to anything yet; a future checkout (Order, not this phase) re-checks
  /// against the live Deal price before charging.
  unitPrice Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  deal Deal @relation(fields: [dealId], references: [id])

  @@unique([cartId, dealId])
  @@index([dealId])
}

/// A customer's "saved for later" list — any deal type (service or product), unlike Cart which
/// is product-only. customerId is always req.user.sub, never client-supplied, same resolution
/// as Cart/Booking. Visibility of an item's Deal is re-checked at read time against
/// catalog.service.ts's VISIBLE_DEAL_WHERE (not enforced here in the DB — a Deal can legitimately
/// go inactive/rejected after being wishlisted, and the item should just stop appearing rather
/// than being deleted, so the customer's intent isn't silently lost if the deal comes back).
model WishlistItem {
  id         String   @id @default(uuid())
  customerId String
  dealId     String
  createdAt  DateTime @default(now())

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal     Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([customerId, dealId])
  @@index([customerId])
  @@index([dealId])
}

/// One row = one appointment request for exactly one SERVICE deal (deal.serviceId != null,
/// enforced in booking.service.ts) OR one Therapist package booked directly, independent of any
/// Deal (see TherapistPackage's own doc comment) — exactly one of `dealId`/`therapistId` is set,
/// never neither (enforced in booking.service.ts, no DB-level CHECK constraint, same discipline
/// as Deal's own "exactly one of serviceId/productId"). Deliberately no BookingItem sub-table:
/// unlike a product cart — which exists specifically to accumulate several different deals
/// before one checkout — a service booking is itself the commitment the moment it's created (an
/// appointment request against a specific date+slot), so Booking is already the atomic unit, the
/// same way Deal (or a directly-booked Therapist) is already the atomic sellable unit.
model Booking {
  id         String @id @default(uuid())
  /// Always req.user.sub, never client-supplied.
  customerId String
  /// Nullable — absent for a Therapist booked directly (no Deal involved at all); see this
  /// model's own doc comment for the "exactly one of dealId/therapistId" invariant.
  dealId     String?
  /// Denormalized from deal.vendorId/branchId (or, for a Deal-less booking, from the booked
  /// Therapist's own vendorId/branchId) at booking time, mirroring Deal's own existing pattern —
  /// lets ownership queries (a vendor's own bookings) skip a join.
  vendorId   String
  branchId   String
  /// Required when `dealId` is absent (a Therapist booked directly); optional otherwise — "Any
  /// therapist" remains a valid choice for a Deal booking. When set, must belong to the same
  /// vendor+branch as the Deal (or, for a direct booking, simply be the Therapist being booked)
  /// and be active — enforced in booking.service.ts, never trusted from the client. No onDelete
  /// cascade: Therapists are never hard-deleted (only soft-disabled via isActive), so this
  /// reference can never be orphaned.
  therapistId String?
  /// Traceability only — which TherapistPackage priced this booking (always set for a direct
  /// Therapist booking; set for a Deal booking only when a matching-duration therapist package
  /// was selected), set once at creation. Never re-read for price/duration
  /// (priceSnapshot/durationMinutesSnapshot below remain the sole source of truth, exactly like
  /// every other Booking snapshot field); `SetNull` on delete so a vendor removing a package
  /// later can never corrupt a past booking's history.
  therapistPackageId String?
  /// Which DealPackage the customer selected (required for a service Deal that has active
  /// packages — see booking.service.ts#createBookingFromDeal). Same traceability-only discipline
  /// and `SetNull` reasoning as therapistPackageId above.
  dealPackageId String?

  /// Nullable — this is a service purchase, not an appointment-scheduling system; the customer
  /// is never required to pick a date/time to complete a booking. When set, it's a customer- or
  /// vendor-supplied preference/follow-up detail, not a slot-capacity reservation (no
  /// availability model exists — a later phase, same as before this field became optional).
  bookingDate DateTime?
  /// Free text for now (e.g. "10:00 AM"), matching the existing storefront's TIME_OPTIONS.
  /// Nullable for the same reason as bookingDate above.
  timeSlot    String?
  quantity    Int      @default(1)

  /// Immutable — copied from deal.salePrice (or, when a TherapistPackage was selected/required,
  /// from its sellingPrice) at booking time, never re-read from Deal/TherapistPackage again, so
  /// a later price change can never alter an existing booking's historical amount.
  priceSnapshot           Decimal @db.Decimal(10, 2)
  /// Immutable — copied from deal.durationMinutes (or, for a direct Therapist booking, from the
  /// booked TherapistPackage's own durationMinutes) at booking time.
  durationMinutesSnapshot Int?

  status             BookingStatus @default(PENDING)
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer         User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal             Deal?             @relation(fields: [dealId], references: [id])
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  branch           Branch            @relation(fields: [branchId], references: [id])
  therapist        Therapist?        @relation(fields: [therapistId], references: [id])
  therapistPackage TherapistPackage? @relation(fields: [therapistPackageId], references: [id], onDelete: SetNull)
  dealPackage      DealPackage?      @relation(fields: [dealPackageId], references: [id], onDelete: SetNull)
  order            Order?

  @@index([customerId])
  @@index([vendorId])
  @@index([branchId])
  @@index([dealId])
  @@index([therapistId])
  @@index([therapistPackageId])
  @@index([dealPackageId])
}

// ─── Order (Phase 8 — Booking/Cart convergence point) ────────────────────────

/// The single convergence point for both purchase flows (Booking -> Order for services, Cart ->
/// Order for products) — never re-reads Deal/Vendor/Branch after creation; every display field
/// is snapshotted once (see OrderItem + vendorNameSnapshot/branchNameSnapshot below), so a later
/// Deal price edit, Vendor rename, or Branch address change can never alter an existing Order.
///
/// Multi-vendor: a PRODUCT order created from a cart may span several vendors/branches in one
/// checkout/one payment (see order.service.ts#createOrderFromCart) — the real, authoritative
/// per-line vendor/branch lives on OrderItem below, not here. `vendorId`/`branchId`/
/// `vendorNameSnapshot`/`branchNameSnapshot` on Order are the "primary vendor" (the first item's
/// vendor at creation time) kept for backward compatibility with every existing single-vendor
/// display (order-detail header, invoice header, admin list) — for a single-vendor order (still
/// the common case: every SERVICE order, and any PRODUCT order whose cart happened to hold one
/// vendor) these are byte-identical to every item's own vendor, so nothing about the existing
/// single-vendor experience changes. Vendor-scoped authorization (who may list/see this order)
/// MUST check OrderItem.vendorId, never this field alone — see order.service.ts#listOrders.
model Order {
  id         String      @id @default(uuid())
  customerId String
  vendorId   String
  branchId   String
  type       OrderType
  status     OrderStatus @default(PENDING_PAYMENT)

  /// One-to-one, unique — the DB-level guarantee that one Booking can never produce two Orders
  /// (order.service.ts additionally pre-checks this for a clean 409 instead of a raw DB error).
  bookingId String? @unique

  /// Snapshotted once at creation — "primary vendor" for a multi-vendor order, see the model
  /// doc comment above. Display must prefer these (or, for per-line vendor, OrderItem's own)
  /// over the live Vendor/Branch relation.
  vendorNameSnapshot String
  branchNameSnapshot String

  /// Checkout's "Customer Details" step — collected/confirmed once per order, before payment.
  /// Nullable: every pre-existing Order predates this step, and it stays optional at the schema
  /// level so it's never a breaking change for a caller that omits it; the frontend enforces
  /// "required before payment" as UX, not a DB constraint.
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingPincode String?

  subtotal Decimal @db.Decimal(10, 2)
  /// == subtotal for now (no coupons/tax/delivery yet) — stored separately because they'll
  /// diverge once those later phases exist.
  total    Decimal @db.Decimal(10, 2)

  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor   Vendor      @relation(fields: [vendorId], references: [id])
  branch   Branch      @relation(fields: [branchId], references: [id])
  booking  Booking?    @relation(fields: [bookingId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([customerId])
  @@index([vendorId])
  @@index([branchId])
  @@index([status])
}

/// Every Order has at least one OrderItem — a SERVICE order always has exactly one (copied from
/// its Booking's already-immutable snapshot), a PRODUCT order has one per CartItem checked out.
/// Keeping this uniform means nothing downstream ever special-cases "service order has zero
/// items, read order.booking instead."
///
/// Each item carries its OWN vendor/branch (never re-read from Deal — see Order's doc comment):
/// a multi-vendor PRODUCT order groups items from several vendors under one Order/one Payment,
/// and vendor-scoped authorization (a vendor's own order listing/detail) filters and matches on
/// THESE fields, not Order.vendorId. For a SERVICE order or a single-vendor PRODUCT order this is
/// simply identical to the parent Order's own vendorId/branchId — no behavior change there.
/// A line item is a Deal purchase, a directly-booked Therapist purchase, or a Product purchase —
/// exactly one of `dealId`/`therapistId` is ever set for a SERVICE item (never neither, mirrors
/// Booking's own "exactly one" invariant — see Booking's doc comment), and neither for a PRODUCT
/// item. `therapistPackageId` accompanies `therapistId` for a direct Therapist purchase, or
/// stands alongside `dealId` when a Deal booking used a matching-duration therapist package.
model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  vendorId  String
  branchId  String
  /// Kept for admin traceability only — display must use the snapshot fields below, never
  /// re-read Deal. Nullable — absent for a Therapist purchased directly, with no Deal involved.
  dealId  String?
  /// Traceability only, same discipline as Booking.therapistId/therapistPackageId — never
  /// re-read for price/duration, the snapshot fields below remain authoritative.
  therapistId        String?
  therapistPackageId String?
  /// Which DealPackage priced this line item, same traceability-only discipline. Never set for a
  /// product line item or a Therapist-direct line item.
  dealPackageId String?

  itemName           String    // service.name / therapistType+personName / product.name at order time
  itemType            OrderType
  vendorNameSnapshot String
  branchNameSnapshot String
  unitPrice       Decimal   @db.Decimal(10, 2)
  quantity        Int
  lineTotal       Decimal   @db.Decimal(10, 2)
  /// Service only — never set for a product line item.
  durationMinutes Int?

  deal             Deal?             @relation(fields: [dealId], references: [id])
  dealPackage      DealPackage?      @relation(fields: [dealPackageId], references: [id], onDelete: SetNull)
  therapist        Therapist?        @relation(fields: [therapistId], references: [id])
  therapistPackage TherapistPackage? @relation(fields: [therapistPackageId], references: [id], onDelete: SetNull)
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  branch           Branch            @relation(fields: [branchId], references: [id])

  @@index([orderId])
  @@index([dealId])
  @@index([vendorId])
  @@index([therapistId])
  @@index([therapistPackageId])
  @@index([dealPackageId])
}

// ─── Payment (Phase 9 — Razorpay) ─────────────────────────────────────────────

/// Order 1 -> Payment[], deliberately NOT one-to-one: a retry (after a FAILED/CANCELLED
/// attempt) creates a new Payment row against the SAME Order rather than a new Order, so
/// "customer clicks Pay twice" or "payment fails then customer retries" never multiplies
/// Orders — only ever Payment attempts. See payment.service.ts for the reuse-vs-create rule.
model Payment {
  id       String          @id @default(uuid())
  orderId  String
  provider PaymentProvider @default(RAZORPAY)

  /// Razorpay order_xxx — one per attempt/row. NOT globally unique — a combined checkout (Deal
  /// + Therapist + Product together: one checkout action, one payment, multiple Order rows
  /// under the hood, see payment.service.ts's `*Batch` functions) creates ONE Razorpay order
  /// funding several msd Orders at once, so several Payment rows legitimately share the same
  /// providerOrderId (one per Order in the batch). Indexed, not unique — lookups use `findMany`.
  providerOrderId String
  /// Razorpay pay_xxx — set only once a payment actually succeeds. Same batch-sharing reasoning
  /// as providerOrderId above.
  providerPaymentId String?

  /// == Order.total at the moment this Payment was created — server-computed from the
  /// authoritative Order, never a client-supplied amount.
  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  status        PaymentStatus @default(CREATED)
  failureReason String?
  /// True only once the server has independently recomputed and matched Razorpay's HMAC
  /// signature (widget-callback or webhook path) — never set from a bare frontend claim.
  signatureVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([providerOrderId])
  @@index([providerPaymentId])
}
