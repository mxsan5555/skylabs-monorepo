{
  "name": "msd-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/msd-api/src",
  "projectType": "application",
  "targets": {
    "prisma-generate": {
      "cache": true,
      "inputs": ["{projectRoot}/prisma/schema.prisma"],
      "outputs": ["{projectRoot}/src/generated"],
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma generate --schema=apps/msd-api/prisma/schema.prisma"
      }
    },
    "build": {
      "dependsOn": ["prisma-generate", "^build"]
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/msd-api/package.json",
        "{workspaceRoot}/dist/apps/msd-api/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/msd-api/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "msd-api:build",
        "runBuildTargetDependencies": false
      }
    }
  },
  "tags": []
}
