# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres database "msd" — fully independent from mera-driver-api's database.
DATABASE_URL="postgresql://postgres:vinay@123@localhost:5432/msd-api?schema=public"

# API
PORT=3333
NODE_ENV=development

# JWT
JWT_SECRET="dev-only-secret-do-not-use-in-prod-0123456789abcdef0123456789abcdef"
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE_LIMIT_PER_10_MIN=5

# Seed SuperAdmin identifier — used once by prisma/seed.ts to pre-create the SuperAdmin
# user with the super_admin role already attached (see seed.ts's seedSuperAdminUser()).
