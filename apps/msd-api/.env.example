# Copy to .env.local and fill in real values. Never commit .env.local.
# This file is a TEMPLATE — every value here is a placeholder. Put real secrets only in
# .env.local (local) or on the host (Railway). Never commit a real credential here.

# Postgres database "msd" — fully independent from mera-driver-api's database.
# Local: your local Postgres. Production (Railway): your Neon connection string.  
# DATABASE_URL="postgresql://neondb_owner:npg_2oMWcyXOpCV7@ep-still-darkness-avpki6g5-pooler.c-11.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL="postgresql://postgres:Hu4fT89e@localhost:5432/msd-api?schema=public"

# API
PORT=3333
NODE_ENV=development

# JWT — generate a strong random string per environment (e.g. `openssl rand -hex 32`).
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE_LIMIT_PER_10_MIN=5
OTP_IDENTIFIER_RATE_LIMIT_PER_HOUR=10
# Proxies in front of the API: 1 on Railway, unset locally.
TRUST_PROXY_HOPS=
# Swagger /docs is off in production unless API_DOCS=true.
API_DOCS=

# Seed SuperAdmin identifier — used once by prisma/seed.ts to pre-create the SuperAdmin
# user with the super_admin role already attached (see seed.ts's seedSuperAdminUser()).
SUPERADMIN_PHONE=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3333/api/v1/auth/google/callback"

# Frontend origin(s) allowed via CORS — comma-separated. Production: your Vercel domain(s).
CORS_ORIGIN="http://localhost:4200"

# SMTP — real email OTP delivery (e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Massage Deals <no-reply@example.com>"

# SMS gateway (connectexpress.in) — real phone OTP delivery
SMS_API_URL=https://connectexpress.in/api/v3/
SMS_API_KEY=
SMS_SENDER=

# Razorpay — Orders & Payments module (use test keys locally)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Media storage — Cloudflare R2 (S3-compatible). See docs/DEPLOYMENT.md §6.
# The API only needs these four upload credentials; the public URL is a frontend concern
# (VITE_MEDIA_BASE_URL in apps/msd), so it is NOT read here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=msd-media
# Private bucket (public access off) for member documents; locally use msd-private-dev.
R2_PRIVATE_BUCKET=msd-private

# Member lifecycle
SUPPORT_EMAIL=
SUPPORT_PHONE=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
DOC_HASH_PEPPER=

# Scheduled jobs (Railway cron calls POST /api/v1/internal/jobs/document-reminders with
# header x-cron-secret). Unset = the job route answers 503. 32+ chars: openssl rand -hex 32
CRON_SECRET=

# Local test accounts only (never set in production; the API refuses to boot with it).
# Their OTP prints in the msd-api console instead of being sent. Seed them first:
# npm run msd-api:prisma:seed-dev-users
DEV_OTP_IDENTIFIERS=9112312391,9122558891,9177889991,9144556610
