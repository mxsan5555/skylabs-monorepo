# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres database "msd" — fully independent from mera-driver-api's database.
DATABASE_URL="postgresql://Hu4fT89e:@localhost:5432/msd-api?schema=public"

# API
PORT=3333
NODE_ENV=development

# JWT
JWT_SECRET="replace-with-a-random-64-char-string"
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE_LIMIT_PER_10_MIN=5

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3333/api/v1/auth/google/callback"

# Frontend origin allowed via CORS
CORS_ORIGIN="http://localhost:4200"



