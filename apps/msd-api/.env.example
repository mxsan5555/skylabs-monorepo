# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3333/api/v1/auth/google/callback"

# Frontend origin allowed via CORS
CORS_ORIGIN="http://localhost:4200"

