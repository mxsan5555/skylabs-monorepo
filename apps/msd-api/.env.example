PORT=4300

# postgresql://<user>:<password>@<host>:5432/msd
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/msd

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Google Cloud Console -> APIs & Services -> Credentials (create a client dedicated to msd)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4300/api/auth/google/callback

# Frontend origin(s) allowed to call this API + where OAuth/exchange redirects land
FRONTEND_URL=http://localhost:4200

# SMTP for OTP emails — Gmail (use an App Password, not the account password) or any
# provider. Dev fallback: an Ethereal Email test inbox (https://ethereal.email).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Massage Deals <no-reply@example.com>"

# SMS gateway for phone OTP (e.g. connectexpress.in — GET request with
# api_key/method=sms/sender/to/message params)
SMS_API_URL=https://connectexpress.in/api/v3/
SMS_API_KEY=
SMS_SENDER=

# Razorpay (test-mode keys from https://dashboard.razorpay.com/app/keys).
# Checkout/webhook routes return 503 until these are set — the rest of the API
# works without them.

RAZORPAY_KEY_ID=rzp_test_nyTqNRxl8rWhmi
RAZORPAY_KEY_SECRET=TFhnDfnlSG8gZawU15zboKGH
RAZORPAY_WEBHOOK_SECRET=
