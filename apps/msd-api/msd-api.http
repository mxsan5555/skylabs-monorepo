###############################################################################
# msd-api — all API endpoints (VS Code REST Client)
#
# HOW TO USE
# 1. Install the "REST Client" VS Code extension (publisher: Huachao Mao).
# 2. Start the API:  npx nx serve msd-api   (http://localhost:3333/api/v1)
# 3. Run the LOGIN flow first (Auth section): send "otp/request", read the OTP,
#    then send "otp/verify" — its response auto-fills {{accessToken}} for every
#    other request below (via the `# @name login` capture).
# 4. Click the "Send Request" link that appears above each `###` request.
#
# Notes
# - {{baseUrl}} already includes the /api/v1 prefix.
# - Protected routes send `Authorization: Bearer {{accessToken}}`. Public ones don't.
# - Replace the @id placeholders (@roleId, @vendorId, …) with real IDs from list calls.
# - Image/video uploads are multipart/form-data — one full example is shown; the rest
#   are marked `# (multipart upload)` — copy the example's body shape for those.
# - Full request/response schemas: open http://localhost:3333/docs (Swagger).
###############################################################################

@baseUrl = http://localhost:3333/api/v1
@contentType = application/json

# Filled automatically by the login request below. You can also paste a token here.
@accessToken = {{login.response.body.$.data.accessToken}}
@refreshToken = {{login.response.body.$.data.refreshToken}}

# ---- ID placeholders: replace with real values from the list endpoints ----
@roleId = 00000000-0000-0000-0000-000000000000
@userId = 00000000-0000-0000-0000-000000000000
@targetUserId = 00000000-0000-0000-0000-000000000000
@widgetKey = sales_summary
@vendorId = 00000000-0000-0000-0000-000000000000
@branchId = 00000000-0000-0000-0000-000000000000
@dealId = 00000000-0000-0000-0000-000000000000
@therapistId = 00000000-0000-0000-0000-000000000000
@packageId = 00000000-0000-0000-0000-000000000000
@productId = 00000000-0000-0000-0000-000000000000
@categoryId = 00000000-0000-0000-0000-000000000000
@tagId = 00000000-0000-0000-0000-000000000000
@blogPostId = 00000000-0000-0000-0000-000000000000
@orderId = 00000000-0000-0000-0000-000000000000
@cartItemId = 00000000-0000-0000-0000-000000000000
@imageId = 00000000-0000-0000-0000-000000000000
@notificationId = 00000000-0000-0000-0000-000000000000
@documentType = pan
@categorySlug = massage
@vendorSlug = my-vendor
@blogSlug = my-post


###############################################################################
# AUTH  (/auth)
###############################################################################

### Request an OTP (email or phone in `identifier`)
POST {{baseUrl}}/auth/otp/request
Content-Type: {{contentType}}

{
  "identifier": "san_allways@yahoo.com",
  "purpose": "login"
}

### Verify OTP -> issues tokens. THIS auto-fills {{accessToken}} & {{refreshToken}}.
# @name login
POST {{baseUrl}}/auth/otp/verify
Content-Type: {{contentType}}

{
  "identifier": "san_allways@yahoo.com",
  "otp": "123456"
}

### Google OAuth (open in a browser, not REST Client)
GET {{baseUrl}}/auth/google

### Google OAuth callback (browser only)
GET {{baseUrl}}/auth/google/callback

### Google OAuth failure
GET {{baseUrl}}/auth/google/failure

### Refresh the access token (rotates the refresh token)
POST {{baseUrl}}/auth/refresh
Content-Type: {{contentType}}

{
  "refreshToken": "{{refreshToken}}"
}

### Logout (revoke this refresh token)
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "refreshToken": "{{refreshToken}}"
}

### Logout everywhere (revoke all sessions for the user)
POST {{baseUrl}}/auth/logout-all
Authorization: Bearer {{accessToken}}


###############################################################################
# RBAC  (/rbac)  — bootstrap, roles, users, audit logs, impersonation
###############################################################################

### Bootstrap: the single source of truth the UI renders from (user+roles+perms+menu+widgets)
GET {{baseUrl}}/rbac/bootstrap
Authorization: Bearer {{accessToken}}

### List roles
GET {{baseUrl}}/rbac/roles
Authorization: Bearer {{accessToken}}

### Create role
POST {{baseUrl}}/rbac/roles
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "key": "dispatcher",
  "name": "Dispatcher",
  "description": "Custom role"
}

### Update role
PATCH {{baseUrl}}/rbac/roles/{{roleId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "Dispatcher (renamed)",
  "description": "Updated"
}

### Delete role
DELETE {{baseUrl}}/rbac/roles/{{roleId}}
Authorization: Bearer {{accessToken}}

### Clone role
POST {{baseUrl}}/rbac/roles/{{roleId}}/clone
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "key": "dispatcher-copy",
  "name": "Dispatcher Copy"
}

### Change role status (active/inactive)
PATCH {{baseUrl}}/rbac/roles/{{roleId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "status": "active"
}

### Permissions catalog (menu x action matrix with real Permission.id's)
GET {{baseUrl}}/rbac/permissions/catalog
Authorization: Bearer {{accessToken}}

### Get a role's current permission grants
GET {{baseUrl}}/rbac/roles/{{roleId}}/permissions
Authorization: Bearer {{accessToken}}

### Set a role's permissions (send real permissionId's from the catalog)
PUT {{baseUrl}}/rbac/roles/{{roleId}}/permissions
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "permissionIds": []
}

### Set a role's dashboard widgets
PUT {{baseUrl}}/rbac/roles/{{roleId}}/widgets
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "widgetKeys": ["{{widgetKey}}"]
}

### List dashboard widgets
GET {{baseUrl}}/rbac/dashboard-widgets
Authorization: Bearer {{accessToken}}

### Create dashboard widget
POST {{baseUrl}}/rbac/dashboard-widgets
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "key": "sales_summary",
  "title": "Sales Summary",
  "order": 1
}

### List users
GET {{baseUrl}}/rbac/users?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### Create user
POST {{baseUrl}}/rbac/users
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "New User",
  "email": "newuser@example.com",
  "phone": "9000000000",
  "roleKeys": ["customer"]
}

### Get my own profile
GET {{baseUrl}}/rbac/users/me
Authorization: Bearer {{accessToken}}

### Update my own profile
PATCH {{baseUrl}}/rbac/users/me
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "My New Name"
}

### Update a user
PATCH {{baseUrl}}/rbac/users/{{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "Updated Name"
}

### Delete a user
DELETE {{baseUrl}}/rbac/users/{{userId}}
Authorization: Bearer {{accessToken}}

### Change a user's status
PATCH {{baseUrl}}/rbac/users/{{userId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "status": "active"
}

### Assign a role to a user
POST {{baseUrl}}/rbac/users/{{userId}}/roles/{{roleId}}
Authorization: Bearer {{accessToken}}

### Remove a role from a user
DELETE {{baseUrl}}/rbac/users/{{userId}}/roles/{{roleId}}
Authorization: Bearer {{accessToken}}

### Revoke all of a user's sessions
POST {{baseUrl}}/rbac/users/{{userId}}/sessions/revoke-all
Authorization: Bearer {{accessToken}}

### Reset a user's OTP
POST {{baseUrl}}/rbac/users/{{userId}}/otp/reset
Authorization: Bearer {{accessToken}}

### A user's login history
GET {{baseUrl}}/rbac/users/{{userId}}/login-history
Authorization: Bearer {{accessToken}}

### A user's device sessions
GET {{baseUrl}}/rbac/users/{{userId}}/sessions
Authorization: Bearer {{accessToken}}

### Audit logs
GET {{baseUrl}}/rbac/audit-logs?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### Impersonate ("Login As") — SuperAdmin only, returns a preview token
POST {{baseUrl}}/rbac/impersonate
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "targetUserId": "{{targetUserId}}"
}


###############################################################################
# CATALOG  (/catalog)  — PUBLIC (no token required)
###############################################################################

### Storefront categories
GET {{baseUrl}}/catalog/categories

### One category by slug
GET {{baseUrl}}/catalog/categories/{{categorySlug}}

### Search deals (query params optional)
GET {{baseUrl}}/catalog/deals?page=1&pageSize=20&q=massage

### One deal by id
GET {{baseUrl}}/catalog/deals/{{dealId}}

### Locations (cities/areas)
GET {{baseUrl}}/catalog/locations

### One vendor storefront by slug
GET {{baseUrl}}/catalog/vendors/{{vendorSlug}}

### Therapists
GET {{baseUrl}}/catalog/therapists

### One therapist by id
GET {{baseUrl}}/catalog/therapists/{{therapistId}}

### Blog posts (public)
GET {{baseUrl}}/catalog/blog-posts?page=1&pageSize=10

### One blog post by slug
GET {{baseUrl}}/catalog/blog-posts/{{blogSlug}}

### About-us content (public)
GET {{baseUrl}}/catalog/about-us

### Contact-us content (public)
GET {{baseUrl}}/catalog/contact-us


###############################################################################
# CART  (/cart)  — auth
###############################################################################

### Get my cart
GET {{baseUrl}}/cart
Authorization: Bearer {{accessToken}}

### Add an item (send one of dealId / dealPackageId / therapistId / therapistPackageId)
POST {{baseUrl}}/cart/items
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "dealId": "{{dealId}}",
  "quantity": 1
}

### Update a cart item (quantity)
PATCH {{baseUrl}}/cart/items/{{cartItemId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "quantity": 2
}

### Remove a cart item
DELETE {{baseUrl}}/cart/items/{{cartItemId}}
Authorization: Bearer {{accessToken}}

### Empty the cart
DELETE {{baseUrl}}/cart
Authorization: Bearer {{accessToken}}


###############################################################################
# WISHLIST  (/wishlist)  — auth
###############################################################################

### Get my wishlist
GET {{baseUrl}}/wishlist
Authorization: Bearer {{accessToken}}

### Add a deal to wishlist
POST {{baseUrl}}/wishlist
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "dealId": "{{dealId}}"
}

### Check if a deal is wishlisted
GET {{baseUrl}}/wishlist/check/{{dealId}}
Authorization: Bearer {{accessToken}}

### Remove a deal from wishlist
DELETE {{baseUrl}}/wishlist/{{dealId}}
Authorization: Bearer {{accessToken}}


###############################################################################
# ORDERS  (/orders)  — auth (customer /me/* and admin)
###############################################################################

### Checkout (create order from cart) — body per OrderCheckoutSchema
POST {{baseUrl}}/orders/checkout
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "contactName": "Sandeep",
  "contactPhone": "9000000000",
  "contactEmail": "san_allways@yahoo.com"
}

### My orders
GET {{baseUrl}}/orders/me?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### One of my orders
GET {{baseUrl}}/orders/me/{{orderId}}
Authorization: Bearer {{accessToken}}

### Update one of my orders' status
PATCH {{baseUrl}}/orders/me/{{orderId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "status": "cancelled"
}

### Pay for an order (creates a Razorpay order)
POST {{baseUrl}}/orders/me/{{orderId}}/pay
Authorization: Bearer {{accessToken}}

### Pay for an order via Cash on Delivery
POST {{baseUrl}}/orders/me/{{orderId}}/pay-cod
Authorization: Bearer {{accessToken}}

### Verify a Razorpay payment for an order
POST {{baseUrl}}/orders/me/{{orderId}}/verify-payment
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "razorpayOrderId": "order_xxx",
  "razorpayPaymentId": "pay_xxx",
  "razorpaySignature": "sig_xxx"
}

### Pay a batch of orders (online) — body per OrderBatchSchema
POST {{baseUrl}}/orders/pay-batch
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "orderIds": ["{{orderId}}"]
}

### Pay a batch of orders (COD)
POST {{baseUrl}}/orders/pay-batch/cod
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "orderIds": ["{{orderId}}"]
}

### Verify a batch payment
POST {{baseUrl}}/orders/pay-batch/verify
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "razorpayOrderId": "order_xxx",
  "razorpayPaymentId": "pay_xxx",
  "razorpaySignature": "sig_xxx"
}

### All orders (admin — orders:view)
GET {{baseUrl}}/orders?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### One order (admin)
GET {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{accessToken}}

### Change any order's status (admin — orders:status_change)
PATCH {{baseUrl}}/orders/{{orderId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "status": "confirmed"
}


###############################################################################
# PAYMENTS  (/payments)
###############################################################################

### Razorpay webhook (called by Razorpay; signature-verified, no bearer token)
POST {{baseUrl}}/payments/webhook/razorpay
Content-Type: {{contentType}}
X-Razorpay-Signature: <hmac-signature>

{
  "event": "payment.captured",
  "payload": {}
}


