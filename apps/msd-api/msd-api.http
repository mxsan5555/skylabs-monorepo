###############################################################################

### List products
GET {{baseUrl}}/products?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### One product
GET {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{accessToken}}


###############################################################################
# CATEGORIES  (/categories)  — admin (masters.categories:*)
###############################################################################

### List categories
GET {{baseUrl}}/categories?page=1&pageSize=50
Authorization: Bearer {{accessToken}}

### Create category
POST {{baseUrl}}/categories
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "Massage",
  "type": "category",
  "parentId": null
}

### One category
GET {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{accessToken}}

### Update category
PATCH {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "Massage & Spa"
}

### Change category status
PATCH {{baseUrl}}/categories/{{categoryId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "status": "active"
}

### Delete category
DELETE {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{accessToken}}

### Upload a category image (multipart/form-data) — EXAMPLE for all image uploads
POST {{baseUrl}}/categories/{{categoryId}}/images
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="file"; filename="cat.jpg"
Content-Type: image/jpeg

< ./sample.jpg
------Boundary--

### Delete a category image
DELETE {{baseUrl}}/categories/{{categoryId}}/images/{{imageId}}
Authorization: Bearer {{accessToken}}

### Reorder category images
PATCH {{baseUrl}}/categories/{{categoryId}}/images/reorder
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "orderedImageIds": ["{{imageId}}"]
}

### Set a category's primary image
PATCH {{baseUrl}}/categories/{{categoryId}}/images/{{imageId}}/primary
Authorization: Bearer {{accessToken}}


###############################################################################
# POPULAR TAGS  (/popular-tags)  — admin (masters.tags:*)
###############################################################################

### List tags
GET {{baseUrl}}/popular-tags?page=1&pageSize=50
Authorization: Bearer {{accessToken}}

### Create tag
POST {{baseUrl}}/popular-tags
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "Trending",
  "slug": "trending"
}

### One tag
GET {{baseUrl}}/popular-tags/{{tagId}}
Authorization: Bearer {{accessToken}}

### Update tag
PATCH {{baseUrl}}/popular-tags/{{tagId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "Hot"
}

### Change tag status
PATCH {{baseUrl}}/popular-tags/{{tagId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "status": "active"
}

### Delete tag
DELETE {{baseUrl}}/popular-tags/{{tagId}}
Authorization: Bearer {{accessToken}}

### A tag's mappings (which deals/products it is attached to)
GET {{baseUrl}}/popular-tags/{{tagId}}/mappings
Authorization: Bearer {{accessToken}}

### Add a mapping to a tag
POST {{baseUrl}}/popular-tags/{{tagId}}/mappings
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "targetType": "deal",
  "targetId": "{{dealId}}"
}

### Remove a mapping from a tag
DELETE {{baseUrl}}/popular-tags/{{tagId}}/mappings/deal/{{dealId}}
Authorization: Bearer {{accessToken}}


###############################################################################
# BLOG POSTS  (/blog-posts)  — admin CMS (cms.blog:*)
###############################################################################

### List blog posts
GET {{baseUrl}}/blog-posts?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### Create blog post
POST {{baseUrl}}/blog-posts
Authorization: Bearer {{accessToken}}
