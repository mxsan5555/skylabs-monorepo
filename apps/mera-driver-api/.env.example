# Copy to .env.local and fill in real values. Never commit .env.local.
# This file is a TEMPLATE — every value here is a placeholder. Put real secrets only in
# .env.local (local) or on the host (Railway). Never commit a real credential here.

# Independent Postgres database for mera-driver-api — never share with msd-api.
# Local: your local Postgres. Production (Railway): your Neon connection string.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/mera_driver?schema=public"

PORT=3334

# IDSPay srv2 driving licence verification (server only).
# Confirmed POST/raw JSON contract; credentials stay server-side. Assigned-reviewer authorization is required; login and consent are not prerequisites.
IDSPAY_DL_API_URL=https://javabackend.idspay.in/api/v1/prod/srv2/validation/dl
IDSPAY_DL_API_ID=
IDSPAY_DL_API_KEY=
IDSPAY_DL_TOKEN_ID=

# Optional fallback commission policy: 0..10000 basis points. Empty requires each fare rule to have a configured commission.
BOOKING_COMMISSION_BPS=
# manual (approved human KYC + valid licence) or api (blocked until IDSPay confirmed)
DRIVER_DL_POLICY=manual
# Optional installed Chromium executable for authorized backend PDFs.
DRIVER_PDF_CHROMIUM_PATH=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NODE_ENV=development

# JWT — generate a strong random string per environment (e.g. `openssl rand -hex 32`).
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3334/auth/google/callback"

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Comma-separated list of frontend origins allowed via CORS. Production: your Vercel domain(s).
CORS_ORIGINS="http://localhost:4400"

# Empty means no invented offer expiry. Set an explicit response-window policy in seconds.
TRIP_OFFER_TIMEOUT_SECONDS=
# Existing Google geocoding integration, server-side REST proxy only (optional).
GOOGLE_MAPS_SERVER_KEY=
