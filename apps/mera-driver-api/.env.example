# Copy to .env.local and fill in real values. Never commit .env.local.
# This file is a TEMPLATE — every value here is a placeholder. Put real secrets only in
# .env.local (local) or on the host (Railway). Never commit a real credential here.

# Independent Postgres database for mera-driver-api — never share with msd-api.
# Local: your local Postgres. Production (Railway): your Neon connection string.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/mera_driver?schema=public"

PORT=3334
NODE_ENV=development

# JWT — generate a strong random string per environment (e.g. `openssl rand -hex 32`).
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3334/auth/google/callback"

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Comma-separated list of frontend origins allowed via CORS. Production: your Vercel domain(s).
CORS_ORIGINS="http://localhost:4400"
