# Copy to .env.local and fill in real values. Never commit .env.local.

# Independent Postgres database for mera-driver-api — never share with msd-api.
DATABASE_URL="postgresql://postgres:Hu4fT89e@localhost:5432/mera_driver?schema=public"

PORT=3334

JWT_SECRET="replace-with-a-random-64-char-string"
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3334/auth/google/callback"

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Comma-separated list of origins allowed to call this API in dev
CORS_ORIGINS="http://localhost:4400"
