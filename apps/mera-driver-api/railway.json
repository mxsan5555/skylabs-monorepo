{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npx nx build mera-driver-api"
  },
  "deploy": {
    "startCommand": "node dist/apps/mera-driver-api/main.js",
    "preDeployCommand": "node node_modules/prisma/build/index.js migrate deploy --schema=apps/mera-driver-api/prisma/schema.prisma",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
