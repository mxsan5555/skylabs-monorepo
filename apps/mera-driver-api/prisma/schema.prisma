// mera-driver-api Prisma schema — driver booking business.
// Independent database: `mera_driver`. Never share tables/migrations with msd-api.

generator client {
  provider = "prisma-client-js"
  // Custom output: mera-driver-api and msd-api are independent apps with independent
  // schemas sharing one node_modules — never generate both into the default
  // node_modules/@prisma/client location or one app's generate will clobber the other's.
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  inactive
  blocked
}

enum PermissionAction {
  view
  create
  edit
  delete
  export
  import
  approve
  reject
  upload
  download
  print
  assign
  restore
  permanent_delete
  status_change
  custom
}

enum OtpPurpose {
  login
  signup
  change_phone
  change_email
}

enum LoginMethod {
  otp_email
  otp_phone
  google
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime? // soft delete — never hard-delete user data

  email       String?    @unique
  phone       String?    @unique
  name        String
  googleId    String?    @unique
  status      UserStatus @default(active)
  lastLoginAt DateTime?

  roles                      UserRole[]
  refreshSessions             RefreshSession[]
  loginHistory                LoginHistory[]
  auditLogsAsActor            AuditLog[]             @relation("AuditLogActor")
  impersonationsAsSuperAdmin  ImpersonationSession[]  @relation("ImpersonationSuperAdmin")
  impersonationsAsTarget      ImpersonationSession[]  @relation("ImpersonationTarget")

  @@index([status])
}

// ---------------------------------------------------------------------------
// RBAC core
// ---------------------------------------------------------------------------

model Role {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  key          String   @unique // e.g. "super_admin", "admin", "customer", "driver", "marketing", "sales"
  name         String
  description  String?
  isSystem     Boolean  @default(false) // seeded role, cannot be deleted
  isSuperAdmin Boolean  @default(false) // ONLY place SuperAdmin-style logic appears — used solely by the seed script
  isActive     Boolean  @default(true)

  permissions      RolePermission[]
  users            UserRole[]
  dashboardWidgets RoleDashboardWidget[]

  @@index([isActive])
}

model Permission {
  id        String           @id @default(uuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  menuKey   String
  action    PermissionAction
  key       String           @unique // canonical `${menuKey}:${action}`
  label     String

  roles     RolePermission[]

  @@index([menuKey])
  @@index([action])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model DashboardWidget {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  key         String   @unique
  title       String
  module      String
  description String?

  roles       RoleDashboardWidget[]
}

model RoleDashboardWidget {
  roleId    String
  widgetId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  role      Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  widget    DashboardWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@id([roleId, widgetId])
  @@index([roleId])
  @@index([widgetId])
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model OtpChallenge {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  identifier String // email or phone
  purpose    OtpPurpose
  hashedOtp  String
  attempts   Int        @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?

  @@index([identifier, purpose])
  @@index([expiresAt])
}

model RefreshSession {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String
  hashedToken String    @unique
  ip          String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String? // id of the RefreshSession that rotated this one (replay detection)

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Audit / observability
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  actorUserId String
  action      String
  targetType  String
  targetId    String
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?

  actor       User @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model LoginHistory {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())

  userId    String
  method    LoginMethod
  success   Boolean
  ip        String?
  userAgent String?

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ImpersonationSession {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())

  superAdminUserId String
  targetUserId     String
  startedAt        DateTime  @default(now())
  previewTokenJti  String    @unique

  superAdmin       User @relation("ImpersonationSuperAdmin", fields: [superAdminUserId], references: [id], onDelete: Cascade)
  target           User @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([superAdminUserId])
  @@index([targetUserId])
}
