// mera-driver-api Prisma schema — driver booking business.
// Independent database: `mera_driver`. Never share tables/migrations with msd-api.

generator client {
  provider = "prisma-client-js"
  // Custom output: mera-driver-api and msd-api are independent apps with independent
  // schemas sharing one node_modules — never generate both into the default
  // node_modules/@prisma/client location or one app's generate will clobber the other's.
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  inactive
  blocked
}

enum PermissionAction {
  view
  create
  edit
  delete
  export
  import
  approve
  reject
  upload
  download
  print
  assign
  restore
  permanent_delete
  status_change
  custom
}

enum OtpPurpose {
  login
  signup
  change_phone
  change_email
  password_reset
}

enum LoginMethod {
  otp_email
  otp_phone
  google
  password
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime? // soft delete — never hard-delete user data

  email       String?    @unique
  phone       String?    @unique
  name        String
  googleId    String?    @unique
  passwordHash String?   // nullable — OTP/Google-only users never set one; password login is additive
  status      UserStatus @default(active)
  lastLoginAt DateTime?

  roles                      UserRole[]
  refreshSessions             RefreshSession[]
  loginHistory                LoginHistory[]
  auditLogsAsActor            AuditLog[]             @relation("AuditLogActor")
  impersonationsAsSuperAdmin  ImpersonationSession[]  @relation("ImpersonationSuperAdmin")
  impersonationsAsTarget      ImpersonationSession[]  @relation("ImpersonationTarget")
  permissionOverrides         UserPermissionOverride[]
  driver                      Driver?

  @@index([status])
}

// ---------------------------------------------------------------------------
// RBAC core
// ---------------------------------------------------------------------------

model Role {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  key          String   @unique // e.g. "super_admin", "admin", "customer", "driver", "marketing", "sales"
  name         String
  description  String?
  isSystem     Boolean  @default(false) // seeded role, cannot be deleted
  isSuperAdmin Boolean  @default(false) // ONLY place SuperAdmin-style logic appears — used solely by the seed script
  isActive     Boolean  @default(true)

  permissions      RolePermission[]
  users            UserRole[]
  dashboardWidgets RoleDashboardWidget[]

  @@index([isActive])
}

model Permission {
  id        String           @id @default(uuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  menuKey   String
  action    PermissionAction
  key       String           @unique // canonical `${menuKey}:${action}`
  label     String

  roles     RolePermission[]
  userOverrides UserPermissionOverride[]

  @@index([menuKey])
  @@index([action])
}

// Per-user permission override, layered on top of the role-derived grant set at resolution
// time (see `permission.service.ts#resolveEffectivePermissionsForUser`). 'grant' adds a
// permission the user's roles don't carry; 'revoke' removes one they otherwise would have.
// Never applied to a SuperAdmin-flagged role holder — that access is a hard guarantee.
model UserPermissionOverride {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())

  userId       String
  permissionId String
  effect       String // 'grant' | 'revoke'

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model DashboardWidget {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  key         String   @unique
  title       String
  module      String
  description String?

  roles       RoleDashboardWidget[]
}

model RoleDashboardWidget {
  roleId    String
  widgetId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  role      Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  widget    DashboardWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@id([roleId, widgetId])
  @@index([roleId])
  @@index([widgetId])
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model OtpChallenge {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  identifier String // email or phone
  purpose    OtpPurpose
  hashedOtp  String
  attempts   Int        @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?

  @@index([identifier, purpose])
  @@index([expiresAt])
}

model RefreshSession {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String
  hashedToken String    @unique
  ip          String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String? // id of the RefreshSession that rotated this one (replay detection)

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Audit / observability
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  actorUserId String
  action      String
  targetType  String
  targetId    String
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?

  actor       User @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model LoginHistory {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())

  userId    String
  method    LoginMethod
  success   Boolean
  ip        String?
  userAgent String?

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ImpersonationSession {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())

  superAdminUserId String
  targetUserId     String
  startedAt        DateTime  @default(now())
  previewTokenJti  String    @unique

  superAdmin       User @relation("ImpersonationSuperAdmin", fields: [superAdminUserId], references: [id], onDelete: Cascade)
  target           User @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([superAdminUserId])
  @@index([targetUserId])
}

// ---------------------------------------------------------------------------
// Business domain — Phase 1 (Drivers, Vehicles, Customers, Attendance, Trips group)
// Status/category fields are plain String, not enums: their vocabularies are
// meant to become Masters-table-driven later and are validated at the Zod layer
// for now, not the DB layer.
// ---------------------------------------------------------------------------

model Customer {
  id                  String    @id @default(uuid())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  firstName           String
  lastName            String?
  profileImage        String?
  mobileNumber        String    @unique
  email               String?
  dateOfBirth         String?
  gender              String?
  addressLine1        String?
  addressLine2        String?
  stateId             Int?
  cityId              Int?
  pincode             String?
  alternatePhone      String?
  customerType        String?
  registrationSource  String?
  verificationStatus  String    @default("Pending")
  accountStatus       String    @default("Active")
  lastLoginAt         DateTime?
  notes               String?

  @@index([verificationStatus])
  @@index([accountStatus])
}

model Driver {
  id                    String    @id @default(uuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Self-service linkage — nullable (existing rows start unlinked) and unique (one User can
  // claim at most one Driver record). Set/cleared only via the admin link/unlink actions,
  // never a side effect of anything else. See `resolveOwnDriver` — the ONLY place a caller's
  // own driverId is ever resolved (from `req.user.sub`, never a client-supplied id).
  userId                String?   @unique
  user                  User?     @relation(fields: [userId], references: [id])

  firstName             String
  lastName              String?
  fatherName            String?
  motherName            String?
  email                 String?
  phone                 String?
  emergencyNumber       String?
  dob                   String?
  maritalStatus         String?
  gender                String?
  passportNumber        String?
  religion              String?
  color                 String?
  language              String?
  age                   String?
  height                String?
  weight                String?
  country               String?
  state                 String?
  pincode               String?
  address               String?
  driverType            String?
  status                String    @default("Non-Verified")
  verificationNotes     String?   // staff-set reason for the current status; driver-portal read-only
  // Portal login gate — independent of `status` above (KYC verification stage). 'Active' |
  // 'Inactive'. Changed only via `PATCH /drivers/:id/status` (drivers:status_change), never
  // as a side effect of the KYC `PATCH /drivers/:id`. Enforced at login (`assertDriverAccountActive`)
  // and on every authenticated `/drivers/me*` call (`resolveOwnDriver`), not just hidden in the UI.
  accountStatus         String    @default("Active")
  sourceType            String?
  vehicle               String?
  avatar                String?
  languages             String[] @default([]) // multi-select, master-data-driven (masters.languages) — additive alongside the legacy singular `language` field above

  education             String?
  trainingStatus        String?
  trainingCertificate   String?
  eyeVision             String?
  healthInsurance       String?
  bloodGroup            String?

  licenseDetails        String?
  vehicleType           String?
  dlNo                  String?
  dlIssueDate           String?
  dlExpiryDate          String?
  policeVerifiedStatus  String?
  policeVerifiedNo      String?
  jobType               String?
  experience            String?
  currentSalary         String?
  expectedSalary        String?

  preferredPaymentMode  String?
  amount                String?
  paymentReceiptDate    String?
  bankName              String?
  bankAccountNo         String?
  ifscCode              String?
  branchName            String?
  upiIdOrChequeNo       String?

  documents             DriverDocument[]

  // Multi-step onboarding-form progress — set only by `driver.service.ts`'s
  // `deriveOnboardingFields`, never trusted directly from the client beyond the single
  // `stepCompleted`/`subStepCompleted` pair the step-save endpoint accepts. Independent of
  // `status` above (manual staff verification) — a driver can be a fully onboarded,
  // unverified record.
  //
  // Each top-level tab (1-4) has its own nested sub-steps (see `SUB_COUNTS` in
  // `driver.service.ts`) — `completedSubSteps` is the definitive source of truth, storing
  // one entry per finished (tab, sub) pair encoded as `tab*10+sub` (e.g. tab 2 sub 1 -> 21).
  // `completedSteps`/`currentStep`/`completionPercentage` are all derived FROM it on every
  // save, never written independently, so the two can never drift out of sync.
  onboardingStatus      String    @default("in_progress") // 'in_progress' | 'completed'
  currentStep           Int       @default(1) // the next pending top-level tab (1-4) to resume at
  currentSubStep        Int       @default(0) // the next pending nested sub-step (0-based) within currentStep
  completedSteps        Int[]     @default([]) // top-level tabs (1-4) whose every nested sub-step is done
  completedSubSteps     Int[]     @default([]) // nested (tab, sub) pairs done so far, encoded tab*10+sub
  completionPercentage  Int       @default(0) // % of all nested sub-steps across all 4 tabs completed

  @@index([status])
  @@index([accountStatus])
}

model DriverDocument {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())

  driverId   String
  category   String // 'personal' | 'health' | 'education' | 'police'
  type       String // doc-type dropdown value, e.g. "Aadhaar / National ID"
  regNo      String?
  fileName   String?
  filePath   String?
  mimeType   String?
  sizeBytes  Int?

  driver     Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([category])
}

model Vehicle {
  id                    String    @id @default(uuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  vehicleUid            String    @unique
  customerId            Int?
  vehicleNumber         String    @unique
  vehicleTypeId         Int
  make                  String?
  model                 String?
  variant               String?
  manufacturingYear     String?
  fuelType              String?
  transmission          String?
  color                 String?
  rcNumber              String?
  rcExpiryDate          String?
  insuranceNumber       String?
  insuranceExpiryDate   String?
  status                String    @default("Active")
  notes                 String?

  @@index([status])
}

model AttendanceRecord {
  id                   String    @id @default(uuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  driverId             String
  attendanceDate       String
  checkInTime          String?
  checkOutTime         String?
  checkInLatitude      Float?
  checkInLongitude     Float?
  checkOutLatitude     Float?
  checkOutLongitude    Float?
  status               String    @default("Present")
  totalHours           Float?
  assignedTripId       String?
  leaveType            String?
  leaveReason          String?
  remarks              String?

  @@index([driverId])
  @@index([status])
}

model TripType {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  description String?
  isActive    Boolean  @default(true)
}

model Booking {
  id                     String    @id @default(uuid())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  bookingCode            String    @unique
  customerName           String
  driverName             String?
  vehicleName            String?
  vehicleCategory        String?
  tripTypeName           String?
  pickupAddress          String?
  pickupLat              Float?
  pickupLng              Float?
  dropAddress            String?
  dropLat                Float?
  dropLng                Float?
  scheduledAt            String?
  estimatedDistanceKm    Float?
  estimatedDurationMin   Float?
  estimatedFare          Float?
  finalFare              Float?
  status                 String    @default("requested")
  paymentStatus          String    @default("pending")
  paymentMode            String    @default("cash")
  otp                    String?
  requestedAt            String?
  acceptedAt             String?
  startedAt              String?
  completedAt            String?

  @@index([status])
}

model DriverLocation {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  driverName  String
  phone       String?
  vehicle     String?
  city        String?
  latitude    Float
  longitude   Float
  status      String   @default("Online")
  recordedAt  String?
}

model CancellationReason {
  id                  String   @id @default(uuid())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  code                String   @unique
  reasonText          String
  appliesTo           String   @default("Customer") // 'Customer' | 'Driver' | 'Both'
  penaltyApplicable   String   @default("No") // 'Yes' | 'No'
  status              String   @default("Active")
}

model FareRule {
  id                     String   @id @default(uuid())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  vehicleCategoryName    String
  tripTypeName           String
  zoneName               String
  baseFare               Float
  perKmRate              Float
  perMinRate             Float
  waitingChargePerMin    Float
  minFare                Float
  driverAllowance        Float
  tollIncluded           Boolean  @default(false)
  surgeMultiplier        Float    @default(1.0)
  effectiveFrom          String
  isActive               Boolean  @default(true)
}

// ---------------------------------------------------------------------------
// Master data — simple admin-managed lookup lists behind the "Driver Masters"
// menu group. No FK relations point at these yet (Driver/Vehicle store plain
// strings), so deletes here are hard deletes.
// ---------------------------------------------------------------------------

// Backs the 8 structurally-identical lookup screens (driver-types, education,
// eye-visions, health-docs, personal-docs, police-docs, source-types, statuses),
// one row per (category, name). `category` values are the frontend's menu-route
// segments, e.g. 'driver-types', 'education'.
model MasterListItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  String
  name      String
  status    String   @default("Active") // 'Active' | 'Inactive'

  @@unique([category, name])
  @@index([category])
}

model VehicleType {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  code        String   @unique
  description String?
  status      String   @default("Active")
}

model ServiceZone {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  zoneName     String
  zoneCode     String   @unique
  stateId      Int?
  cityId       Int?
  areaName     String?
  pincode      String?
  zoneType     String   @default("City") // 'City' | 'Area' | 'Pincode' | 'Custom'
  latitude     Float?
  longitude    Float?
  radiusKm     Float?
  boundaryData String?
  status       String   @default("Active")
  notes        String?
}
