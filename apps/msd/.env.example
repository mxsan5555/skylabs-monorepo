# Base URL of msd-api (port 3333 by default). Include the /api/v1 prefix.
# The msd-api Railway domain + /api/v1  (https://<msd-api-railway-domain>/api/v1) is the production value for this variable. Never commit a real credential here.
VITE_API_URL=http://localhost:3333/api/v1

# Public base URL of the Cloudflare R2 bucket holding uploaded media (images/video).
# Uploaded files are served directly from R2, not from the API. Get this from the R2 bucket's
# public access URL, e.g. https://pub-<hash>.r2.dev (see DEPLOYMENT.md → "Set up Cloudflare R2").
VITE_MEDIA_BASE_URL=

# Google Maps JS API key (used by the map + current-location features).
# NOTE: VITE_* vars are baked into the client bundle and are public — restrict
# this key by HTTP referrer in Google Cloud Console. Never put a secret here.
VITE_GOOGLE_MAPS_API_KEY=

# Public WEBSITE origin (not the API) used for canonical URLs, Open Graph, JSON-LD and the
# crawler files, no trailing slash, e.g. https://www.myspadeal.in. Leave empty until the custom
# domain is live: absolute-URL tags, sitemap.xml, robots.txt and llms.txt are then omitted.
VITE_SITE_URL=

# OPTIONAL, build time only (not bundled into the client): a different msd-api base URL, with
# /api/v1, for `nx run msd:prerender` to fetch catalog data from. Leave empty to use VITE_API_URL
# (the normal case). Set it only if the build should reach the API by another address. If the API is
# unreachable the build skips prerendering and still succeeds (the SPA serves every route),
# except on a Vercel production build (see PRERENDER_ALLOW_EMPTY below).
# sitemap.xml, robots.txt and llms.txt also need VITE_SITE_URL set.
PRERENDER_API_URL=

# Build time only: milliseconds `nx run msd:prerender` waits for each data load (the shell load,
# then home/category per route) before giving up on it. Default 15000. A timed-out shell load is
# treated the same as an unreachable API (prerender is skipped, crawler files still get written,
# the build exits 0 outside production); a timed-out route is skipped with a warning and the rest still render.
PRERENDER_TIMEOUT_MS=

# Build time only: on a Vercel production build (VERCEL_ENV=production) the prerender fails the
# build (exit 1) when the API is unreachable or no route rendered, so production never silently
# ships the bare SPA. Set to 1 to allow that anyway (e.g. deploying while msd-api is down).
# Preview and local builds never fail for this reason.
PRERENDER_ALLOW_EMPTY=
