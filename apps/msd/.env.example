# Base URL of msd-api (port 3333 by default). Include the /api/v1 prefix.
# The msd-api Railway domain + /api/v1  (https://<msd-api-railway-domain>/api/v1) is the production value for this variable. Never commit a real credential here.
VITE_API_URL=http://localhost:3333/api/v1

# Public base URL of the Cloudflare R2 bucket holding uploaded media (images/video).
# Uploaded files are served directly from R2, not from the API. Get this from the R2 bucket's
# public access URL, e.g. https://pub-<hash>.r2.dev (see DEPLOYMENT.md → "Set up Cloudflare R2").
VITE_MEDIA_BASE_URL=

# Google Maps JS API key (used by the map + current-location features).
# NOTE: VITE_* vars are baked into the client bundle and are public — restrict
# this key by HTTP referrer in Google Cloud Console. Never put a secret here.
VITE_GOOGLE_MAPS_API_KEY=

# Public site origin used for canonical URLs, Open Graph and JSON-LD (no trailing slash),
# e.g. https://www.myspadeal.in. Leave empty locally; absolute-URL tags are then omitted.
VITE_SITE_URL=

# Build time only (not bundled into the client): msd-api base URL, with /api/v1, that
# `nx run msd:prerender` fetches catalog data from to prerender /, /category/* and city pages.
# Production: the msd-api Railway domain + /api/v1. Falls back to VITE_API_URL. If the API is
# unreachable the build skips prerendering and still succeeds (the SPA serves every route).
# sitemap.xml, robots.txt and llms.txt also need VITE_SITE_URL set.
PRERENDER_API_URL=
