{
  "name": "msd",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/msd/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project msd --web",
  "targets": {
    "prerender": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "npx tsx apps/msd/prerender/prerender.ts" }
    },
    "typecheck": {
      "// typecheck": "ST-14: the browser app and the prerender scripts (Node, bundler module resolution) are checked separately, both always run",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/msd",
        "commands": ["tsc --noEmit -p tsconfig.prerender.json", "tsc --noEmit -p tsconfig.app.json"],
        "parallel": true
      }
    }
  }
}
